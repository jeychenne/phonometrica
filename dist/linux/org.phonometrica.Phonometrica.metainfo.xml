<component type="desktop-application">
  <id>org.phonometrica.Phonometrica</id>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Phonometrica</name>
  <summary>Annotate and analyze speech corpora</summary>
  <description>
    <p>
      Phonometrica is an open-source tool for the annotation and analysis
      of speech corpora. It supports multi-layer time-aligned annotations,
      acoustic queries (formant, pitch, intensity), text concordances, and
      statistical modelling including linear and generalized linear mixed
      models and generalized additive models.
    </p>
  </description>
  <url type="homepage">https://github.com/jeychenne/phonometrica</url>
  <url type="bugtracker">https://github.com/jeychenne/phonometrica/issues</url>
