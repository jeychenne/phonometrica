let root = "/home/julien/Devel/phonometrica/test/data/"
let d = load(root & "gam_test.csv")

print "M1 (baseline additive):"
let m1 = fit("y_gauss ~ vowel + s(age) + s(duration)", d)
summarize(m1)

print "M2 (+ random intercepts):"
let m2 = fit('y_gauss ~ vowel + s(age) + s(duration) + s(speaker, bs="re")', d)
summarize(m2)


print "M3 (+ two-way RE):"
let m3 = fit('y_gauss ~ vowel + s(age) + s(duration) + s(speaker, bs="re") + s(word, bs="re")', d)
summarize(m3)


print "M4 (+ factor-by smooth):"
let m4 = fit('y_gauss ~ vowel + s(age) + s(duration, by = vowel) + s(speaker, bs="re")', d)
summarize(m4)

print "Non-Gaussian variants:"
print "(binomial, logit)   :"
let m5 = fit('y_bin  ~  vowel + s(age) + s(duration) + s(speaker, bs="re")', d, "binomial")
summarize(m5)

print "(Poisson,  log)     :"
let m6 = fit('y_count ~ vowel + s(age) + s(duration) + s(speaker, bs="re")', d, "poisson")
summarize(m6)

print "(neg. binomial)     :"
let m7 = fit('y_nb ~ vowel + s(age) + s(duration) + s(speaker, bs="re")', d, "negbin")
summarize(m7)




