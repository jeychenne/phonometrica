# =====================================================================
# statistics/frequentist/run_all.phon
# =====================================================================
# Runs every test_<family>.phon in this directory, accumulates
# pass/fail counts via the shared stat_assert module, and asserts a
# clean run at the end.
#
# Run with the headless statistics host (MIGRATION_NOTES step 4b):
#     phon_stats -I test/statistics/lib test/statistics/frequentist/run_all.phon
# (the -I flag puts the shared lib on the module search path; each
# test file's own imports resolve in its directory first).
#
# PORT NOTE (old -> new engine): `import` is a compile-time statement
# (no dynamic import(name) loop, no try/catch around a failing import
# — a missing module is a compile error), and imported module
# top-levels run BEFORE this chunk's own statements. Consequences:
#   * the banner and the final tally both print AFTER the tests (the
#     step-3 run_all made the same move);
#   * reset_counters() must NOT be called here — it would zero the
#     tally the imports just accumulated (counters start at 0 anyway);
#   * a model failure inside a test is still recorded-and-continue
#     (fit_and_check wraps fit() in try/catch); only a missing
#     data/reference file aborts the run.
#
# Pre-requisites. Each reference_<family>.json must have been
# generated from R first (gen_reference_all.R).
#
# Student-t is intentionally excluded from the v1.0 suite: the
# glmmTMB references for that family are not trustworthy (see
# test_student.phon's banner). When clean references are available —
# most likely from the Bayesian suite via brms HMC — re-enable by
# adding the import line below.
# =====================================================================

import stat_assert

# Synthetic-data families, ordered roughly by fit time; module
# top-levels run at import, before any statement below.
import test_gaussian
import test_poisson
import test_binomial
import test_negbin
import test_beta
import test_real_schwa
import test_gam
import test_nested

# Disabled: test_student — see its banner.

# ── Final tally (runs after all imported tests). ─────────────────
print("######################################################################")
print("# Phonometrica frequentist statistics validation")
print("######################################################################")
report()
assert(stat_assert.n_failed == 0, "frequentist statistics suite: " & stat_assert.n_failed & " failure(s)")
