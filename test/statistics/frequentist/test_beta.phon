# =====================================================================
# test_beta.phon — validates Phonometrica's frequentist beta regression
# engine against reference_beta.json (produced by gen_reference_beta.R
# from a synthetic task-accuracy dataset).
#
# Why synthetic: real mixed-effects beta-regression datasets are rare
# in standard R packages, and the prior phonetic-style synthetic data
# happened to produce zero random-slope variance. The new generator
# (set.seed(2026)) injects real (sd ≈ 0.4) slope variance for
# difficulty|subject, so every model in the suite converges at an
# interior optimum.
#
# Five models on the synthetic accuracy data (4475 obs):
#   M1 — accuracy ~ difficulty * domain                   (interaction)
#   M2 — accuracy ~ difficulty + domain + (1|subject)
#   M3 — accuracy ~ difficulty + domain + (1+difficulty|subject)
#   M4 — accuracy ~ difficulty + domain + (1|subject) + (1|item)
#   M5 — accuracy ~ difficulty + domain + (1+difficulty|subject) + (1|item)
# =====================================================================

import stat_assert

var DATA = resolve_data_path("beta_accuracy.csv")
var REF  = resolve_sibling("reference_beta.json")

var refs_root = load_reference(REF)
var refs = refs_root["models"]
var d = load(DATA)

start_section("BETA")

fit_and_check("M1", "accuracy ~ difficulty * domain", d, "beta", refs["M1"], 0.001, 0.001, 0.01)
fit_and_check("M2", "accuracy ~ difficulty + domain + (1|subject)", d, "beta", refs["M2"], 0.005, 0.005, 0.05)
fit_and_check("M3", "accuracy ~ difficulty + domain + (1+difficulty|subject)", d, "beta", refs["M3"], 0.005, 0.005, 0.05)
fit_and_check("M4", "accuracy ~ difficulty + domain + (1|subject) + (1|item)", d, "beta", refs["M4"], 0.005, 0.005, 0.05)
fit_and_check("M5", "accuracy ~ difficulty + domain + (1+difficulty|subject) + (1|item)", d, "beta", refs["M5"], 0.01, 0.01, 0.1)

end_section()
