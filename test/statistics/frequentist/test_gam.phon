# =====================================================================
# test_gam.phon — validates Phonometrica's GAM engine against
# reference_gam.json (produced by gen_reference_gam.R using mgcv).
# Dataset: test/data/gam_test.csv (already in the repo)
#
# Run from test/statistics/frequentist/  e.g.:
#   cd test/statistics/frequentist
#   phonometrica -r test_gam.phon
# =====================================================================

import stat_assert

# Literal relative paths — avoid get_script_path, which isn't present
# in older release binaries.  These work when the script is run from
# test/statistics/frequentist/.

var DATA = ""
var REF  = ""
try
    DATA = resolve_data_path("gam_test.csv")
    REF  = resolve_sibling("reference_gam.json")
catch err
    DATA = "../../data/gam_test.csv"
    REF  = "reference_gam.json"
end


var refs_root = load_reference(REF)
var refs      = refs_root["models"]
var d         = load(DATA)


var m5 = fit("y_count ~ s(duration, bs=cr, k=8)", d, "poisson")
print("M5 niter:    " & m5.niter)
print("M5 converged:" & m5.converged)
print("M5 loglik:   " & m5.loglik)
print("M5 nobs:     " & m5.nobs)
print("M5 intercept:" & get_coef(m5)[1])
print("M5 β count:  " & len(get_coef(m5)))
print("β: " & get_coef(m5))


