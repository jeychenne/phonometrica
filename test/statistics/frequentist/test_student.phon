# =====================================================================
# test_student.phon — validates Phonometrica's frequentist Student-t
# regression engine against reference_student.json (produced by
# gen_reference_student.R from a real corpus monophthong dataset).
#
# Why this dataset and not synthetic: prior synthetic data choked
# glmmTMB's t_family() on every random-effects fit (banana-shaped
# σ-ν likelihood, weak ν identification at small N). On the corpus
# data the user verified glmmTMB converges cleanly on all five
# models, putting Student-t on the same engine and tooling as the
# other frequentist families.
#
# Five models on monophtongues.csv:
#   M1 — E1 ~ Voyelle * Condition + Sexe + Age                       (no RE)
#   M2 — E1 ~ Voyelle * Condition + Sexe * Age + (1|Sujet) + (1|Mot)
#   M3 — E1 ~ Voyelle * Condition + Sexe * Age + (1+Voyelle|Sujet) + (1|Mot)
#   M4 — E2 ~ Voyelle * Condition + Sexe * Age + (1+Voyelle|Sujet) + (1|Mot)
#   M5 — E2 ~ Voyelle * Condition + Sexe + Age + (1|Sujet)
#
# Tolerances. glmmTMB and Phonometrica target the same likelihood
# (joint Laplace ML) but differ in optimiser path and Student-t
# parameter handling — glmmTMB carries log(ν) as a dispformula
# coefficient while Phonometrica uses joint (β, θ) Laplace-MAP
# with exact Student-t Hessian weights and a multistart over ν.
# Modest tolerances absorb the per-iterate drift.
# =====================================================================

import stat_assert

var DATA = resolve_data_path("monophtongues.csv")
var REF  = resolve_sibling("reference_student.json")

var refs_root = load_reference(REF)
var refs = refs_root["models"]
var d = load(DATA)

start_section("STUDENT-T")

fit_and_check("M1", "E1 ~ Voyelle * Condition + Sexe + Age", d, "student", refs["M1"], 0.005, 0.005, 0.05)

fit_and_check("M2", "E1 ~ Voyelle * Condition + Sexe * Age + (1|Sujet) + (1|Mot)", d, "student", refs["M2"], 0.01, 0.01, 0.05)

fit_and_check("M3", "E1 ~ Voyelle * Condition + Sexe * Age + (1+Voyelle|Sujet) + (1|Mot)", d, "student", refs["M3"], 0.01, 0.01, 0.10)

fit_and_check("M4", "E2 ~ Voyelle * Condition + Sexe * Age + (1+Voyelle|Sujet) + (1|Mot)", d, "student", refs["M4"], 0.01, 0.01, 0.10)

fit_and_check("M5", "E2 ~ Voyelle * Condition + Sexe + Age + (1|Sujet)", d, "student", refs["M5"], 0.01, 0.005, 0.05)

end_section()
