# =====================================================================
# test_real_schwa.phon — validates Phonometrica's frequentist binomial
# engine on a real-world dataset (Eychenne 2019 schwa data) against
# reference_real_schwa.json (produced by gen_reference_real_schwa.R).
#
# Real binomial dataset (schwa_eychenne2019.csv): 7787 obs, 45
# subjects, 1211 words. Response: schwa ∈ {present, absent}, recoded
# inline to schwa01 ∈ {0, 1} with present = 1.
#
# Five models:
#   M1 — schwa01 ~ dialect * gender + task              (interaction)
#   M2 — schwa01 ~ dialect + gender + task + (1|subject)
#   M3 — schwa01 ~ dialect + gender + task + (1+task|subject)
#   M4 — schwa01 ~ dialect + gender + task + (1|subject) + (1|word)
#   M5 — schwa01 ~ dialect + gender + task + (1+task|subject) + (1|word)
#
# All five reference fits converge cleanly. M5 is the slowest fit
# in the entire suite (~30s for the 1211-level word random intercept
# combined with the 3-dim task slope on subject).
# =====================================================================

import stat_assert

var DATA = resolve_data_path("schwa_eychenne2019.csv")
var REF  = resolve_sibling("reference_real_schwa.json")

var refs_root = load_reference(REF)
var refs = refs_root["models"]
var d = load(DATA)

# Recode response inline to match the R reference (present = 1).
# Self-contained — no external preprocessing step required.
var schwa_col = get_column(d, "schwa")
var n_rows = len(schwa_col)
var schwa01 = ones(n_rows)
for i = 1 to n_rows do
    if schwa_col[i] == "present" then
        schwa01[i] = 1
    else
        schwa01[i] = 0
    end
end
add_column(d, schwa01, "schwa01")

start_section("REAL BINOMIAL (schwa_eychenne2019)")

fit_and_check("M1", "schwa01 ~ dialect * gender + task", d, "binomial", refs["M1"], 0.005, 0.005, 0.05)
fit_and_check("M2", "schwa01 ~ dialect + gender + task + (1|subject)", d, "binomial", refs["M2"], 0.01, 0.01, 0.1)
fit_and_check("M3", "schwa01 ~ dialect + gender + task + (1+task|subject)", d, "binomial", refs["M3"], 0.02, 0.02, 0.2)
fit_and_check("M4", "schwa01 ~ dialect + gender + task + (1|subject) + (1|word)", d, "binomial", refs["M4"], 0.01, 0.01, 0.15)
fit_and_check("M5", "schwa01 ~ dialect + gender + task + (1+task|subject) + (1|word)", d, "binomial", refs["M5"], 0.03, 0.02, 0.25)

end_section()
