# =====================================================================
# test_poisson.phon — validates Phonometrica's frequentist Poisson
# regression engine against reference_poisson.json (produced by
# gen_reference_poisson.R).
#
# Five models on the synthetic disfluency-count data (1800 obs):
#   M1 — count ~ task * age                        (interaction)
#   M2 — count ~ task + age + (1|speaker)
#   M3 — count ~ task + age + (1+task|speaker)
#   M4 — count ~ task + age + (1|speaker) + (1|word)
#   M5 — count ~ task + age + (1+task|speaker) + (1|word)
#
# All five reference fits converge cleanly.
# =====================================================================

let A = import("../lib/assert")

let DATA = A.resolve_data_path("poisson_disfluency.csv")
let REF  = A.resolve_sibling("reference_poisson.json")

let refs_root = A.load_reference(REF)
let refs = refs_root["models"]
let d = load(DATA)

A.start_section("POISSON")

A.fit_and_check("M1", "count ~ task * age", d, "poisson", refs["M1"], 0.001, 0.001, 0.01)
A.fit_and_check("M2", "count ~ task + age + (1|speaker)", d, "poisson", refs["M2"], 0.005, 0.005, 0.05)
A.fit_and_check("M3", "count ~ task + age + (1+task|speaker)", d, "poisson", refs["M3"], 0.01, 0.01, 0.1)
A.fit_and_check("M4", "count ~ task + age + (1|speaker) + (1|word)", d, "poisson", refs["M4"], 0.005, 0.005, 0.05)
A.fit_and_check("M5", "count ~ task + age + (1+task|speaker) + (1|word)", d, "poisson", refs["M5"], 0.01, 0.01, 0.1)

A.end_section()
