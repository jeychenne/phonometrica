# =====================================================================
# test_binomial.phon — validates Phonometrica's frequentist binomial
# regression engine against reference_binomial.json (produced by
# gen_reference_binomial.R).
#
# Five models on the synthetic schwa-realisation data (5400 obs):
#   M1 — realized ~ position * style                    (interaction)
#   M2 — realized ~ position + style + (1|speaker)
#   M3 — realized ~ position + style + (1+style|speaker)
#   M4 — realized ~ position + style + (1|speaker) + (1|word)
#   M5 — realized ~ position + style + (1+style|speaker) + (1|word)
#
# All five reference fits converge cleanly; tolerances are tightest
# for the fixed-only and single-RE models, slightly loosened for the
# random-slope ones where the optimiser may land at alternative
# corners of the random-effect covariance.
# =====================================================================

import stat_assert

var DATA = resolve_data_path("binomial_schwa.csv")
var REF  = resolve_sibling("reference_binomial.json")

var refs_root = load_reference(REF)
var refs = refs_root["models"]
var d = load(DATA)

start_section("BINOMIAL")

fit_and_check("M1", "realized ~ position * style", d, "binomial", refs["M1"], 0.001, 0.001, 0.01)
fit_and_check("M2", "realized ~ position + style + (1|speaker)", d, "binomial", refs["M2"], 0.005, 0.005, 0.05)
fit_and_check("M3", "realized ~ position + style + (1+style|speaker)", d, "binomial", refs["M3"], 0.01, 0.01, 0.1)
fit_and_check("M4", "realized ~ position + style + (1|speaker) + (1|word)", d, "binomial", refs["M4"], 0.005, 0.005, 0.05)
fit_and_check("M5", "realized ~ position + style + (1+style|speaker) + (1|word)", d, "binomial", refs["M5"], 0.01, 0.01, 0.1)

end_section()
