# =============================================================================
# Phonometrica REML validation.
#
# Compare against test/data/reml_reference.tsv (generated by
# test/gen_reference_reml_gaussian.R). Run from the repository root.
# =============================================================================

# Resolve the repository root from this script (test/statistics/frequentist -> up 3).
var ROOT = get_directory(get_directory(get_directory(get_directory(get_script_path()))))

# ── Case 1: simple random intercept ──────────────────────────────────────────
print("=== Case 1: f1 ~ gender + (1 | speaker) ===")
print("")

var d1 = load(join_path(ROOT, "test/data/gaussian_f1.csv"))

print("--- ML (default) ---")
var m1_ml = fit("f1 ~ gender + (1 | speaker)", d1)
summarize(m1_ml)
print("")

print("--- REML (opt-in) ---")
var m1_reml = fit("f1 ~ gender + (1 | speaker)", d1, {"fit_method": "REML"})
summarize(m1_reml)
print("")

# ── Case 2: random intercept + slope on sleepstudy ───────────────────────────
print("=== Case 2: Reaction ~ Days + (1 + Days | Subject) on sleepstudy ===")
print("")

var d2 = load(join_path(ROOT, "test/data/sleepstudy.tsv"))

print("--- ML (default) ---")
var m2_ml = fit("Reaction ~ Days + (1 + Days | Subject)", d2)
summarize(m2_ml)
print("")

print("--- REML (opt-in) ---")
var m2_reml = fit("Reaction ~ Days + (1 + Days | Subject)", d2, {"fit_method": "REML"})
summarize(m2_reml)
print("")

# ── Guard checks: anova_compare must error on bad REML usage ────────────────
print("=== Guard check 1: mixing ML and REML in compare() must throw ===")
try
    compare(m1_ml, m1_reml)
    print("FAIL: expected an error for mixed ML/REML comparison")
catch e
    print("OK: " & e.message)
end
print("")

print("=== Guard check 2: REML compare with different fixed effects must throw ===")
var m1_reml_alt = fit("f1 ~ 1 + (1 | speaker)", d1, {"fit_method": "REML"})
try
    compare(m1_reml_alt, m1_reml)
    print("FAIL: expected an error for REML with different fixed effects")
catch e
    print("OK: " & e.message)
end
print("")

print("=== Guard check 3: REML compare with SAME fixed effects is OK ===")
# Both have the same fixed-effects design; different (or same) RE structure
# should be allowed under REML. Here both have the same RE structure too —
# the point is to confirm the check does not erroneously fire.
try
    compare(m1_reml, m1_reml)
    print("OK: same-fixed-effects REML comparison allowed")
catch e
    print("FAIL: " & e.message)
end
print("")

# ── Inapplicable REML: should fall back to ML with a warning ────────────────
print("=== Inapplicable REML: fixed-effects-only Gaussian should fall back ===")
var m_no_re = fit("f1 ~ gender", d1, {"fit_method": "REML"})
summarize(m_no_re)
print("")

print("=== Inapplicable REML: binomial GLMM should fall back ===")
# Synthesize a binary outcome for the gaussian_f1 data.
# (Only meaningful if the dataset has a suitable column; adjust as needed.)
# Skipped if no binary column exists — purely for the warning path.

print("All cases complete. Compare the values above to test/data/reml_reference.tsv.")
