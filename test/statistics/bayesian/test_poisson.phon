# =====================================================================
# test_poisson.phon — Bayesian Poisson fit on the synthetic
# disfluency-counts dataset. Five models match
# frequentist/test_poisson.phon.
# =====================================================================

import stat_assert
import bayes_assert

var DATA = resolve_data_path("poisson_disfluency.csv")
var REF  = resolve_sibling("reference_poisson.json")

var refs_root = load_reference(REF)
var refs = refs_root["models"]
var d = load(DATA)

start_section("BAYESIAN POISSON")

var tol_default = default_tolerance()
var tol_slope = default_tolerance()
tol_slope["mean_rel"]       = 0.30
tol_slope["sd_rel"]         = 0.30
tol_slope["ci_rel"]         = 0.50
tol_slope["hyper_mean_rel"] = 0.40
tol_slope["hyper_sd_rel"]   = 0.40
tol_slope["hyper_ci_rel"]   = 0.50

bayes_fit_and_check("M1", "count ~ task * age", d, "poisson", refs["M1"], tol_default)
bayes_fit_and_check("M2", "count ~ task + age + (1|speaker)", d, "poisson", refs["M2"], tol_default)
bayes_fit_and_check("M3", "count ~ task + age + (1+task|speaker)", d, "poisson", refs["M3"], tol_slope)
bayes_fit_and_check("M4", "count ~ task + age + (1|speaker) + (1|word)", d, "poisson", refs["M4"], tol_default)
bayes_fit_and_check("M5", "count ~ task + age + (1+task|speaker) + (1|word)", d, "poisson", refs["M5"], tol_slope)

end_section()
