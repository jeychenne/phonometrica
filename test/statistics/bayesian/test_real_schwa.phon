# =====================================================================
# test_real_schwa.phon — Bayesian binomial fit on the real schwa
# corpus (schwa_eychenne2019.csv). Five models match
# frequentist/test_real_schwa.phon and the brms reference produced by
# gen_reference_real_schwa.R.
#
# Real binomial dataset (7787 obs, 45 subjects, 1211 words). Response:
# schwa ∈ {present, absent, uncertain}, recoded inline to schwa01 with
# present = 1 and everything else = 0 (matches the frequentist suite).
# =====================================================================

import stat_assert
import bayes_assert

var DATA = resolve_data_path("schwa_eychenne2019.csv")
var REF  = resolve_sibling("reference_real_schwa.json")

var refs_root = load_reference(REF)
var refs = refs_root["models"]
var d = load(DATA)

# Recode response inline to match the R reference (present = 1).
var schwa_col = get_column(d, "schwa")
var n_rows = len(schwa_col)
var schwa01 = ones(n_rows)
for i = 1 to n_rows do
    if schwa_col[i] == "present" then
        schwa01[i] = 1
    else
        schwa01[i] = 0
    end
end
add_column(d, schwa01, "schwa01")

start_section("BAYESIAN REAL SCHWA")

var tol_default = default_tolerance()
var tol_slope = default_tolerance()
tol_slope["mean_rel"]       = 0.30
tol_slope["sd_rel"]         = 0.30
tol_slope["ci_rel"]         = 0.50
tol_slope["hyper_mean_rel"] = 0.40
tol_slope["hyper_sd_rel"]   = 0.40
tol_slope["hyper_ci_rel"]   = 0.50

bayes_fit_and_check("M1", "schwa01 ~ dialect * gender + task", d, "binomial", refs["M1"], tol_default)
bayes_fit_and_check("M2", "schwa01 ~ dialect + gender + task + (1|subject)", d, "binomial", refs["M2"], tol_default)
bayes_fit_and_check("M3", "schwa01 ~ dialect + gender + task + (1+task|subject)", d, "binomial", refs["M3"], tol_slope)
bayes_fit_and_check("M4", "schwa01 ~ dialect + gender + task + (1|subject) + (1|word)", d, "binomial", refs["M4"], tol_default)
bayes_fit_and_check("M5", "schwa01 ~ dialect + gender + task + (1+task|subject) + (1|word)", d, "binomial", refs["M5"], tol_slope)

end_section()
