# =====================================================================
# test_gam.phon
# =====================================================================
# Validates Phonometrica's Bayesian GAM engine against
# reference_gam.json (produced by R-INLA in gen_reference_gam.R from
# Chapter 9 of "Bayesian Regression Modeling with INLA").
#
# Two models:
#   M_A — gamSim Gaussian:
#       y ~ s(x0) + s(x1) + s(x2) + s(x3)              (n=400, simulated)
#   M_K — kyphosis binomial:
#       Kyphosis ~ s(Age) + s(StartVert) + s(NumVert)  (n=83)
#
# ★★★ Apples-to-oranges comparison — read this before interpreting failures ★★★
#
# Unlike the BLR/GLM/GLMM slices, this slice compares fundamentally
# different smooth bases:
#   * Phon: cubic regression splines (mgcv-style "cr" basis), k=10
#   * INLA: 2nd-order random walks ("rw2") on inla.group'd knot points
#
# The slice scope is a SMOKE TEST: don't crash, converge, hit roughly
# the same WAIC and intercept. Smooth coefficients, EDFs, and smooth
# precisions are NOT compared (basis-specific quantities). See
# gen_reference_gam.R header for the full discussion.
#
# Tolerances are deliberately loose. Tightening is deferred to
# post-v1.0 when the basis-parity rewrite lands.
# =====================================================================

import stat_assert
import bayes_assert

# Three levels below test/, so the data path is spelled out rather than
# going through resolve_data_path (which assumes two).
var DATA_GAM_SIM  = resolve_sibling("../../../data/gam_sim_brinla.csv")
var DATA_KYPHOSIS = resolve_sibling("../../../data/kyphosis_brinla.csv")
var DATA_GAM_TEST = resolve_sibling("../../../data/gam_test.csv")
var REF           = resolve_sibling("reference_gam.json")

var refs_root = load_reference(REF)
var refs = refs_root["models"]

start_section("BAYESIAN GAM (Ch9 INLA-reference, smoke test)")

# ── Loose tolerance for the basis-mismatched comparison ───────────
# Five times wider than tol_inla on means; ten times wider on CIs;
# WAIC absolute tolerance bumped to 25 since the two bases choose
# very different effective complexities for the same data. p_WAIC
# is bumped specifically — Phon's k=10 cr basis runs ~14 effective
# parameters on gam_sim while INLA's 20-knot rw2 runs ~19; the
# 5-unit gap is a structural property of the bases, not drift.
var tol_gam = default_tolerance()
tol_gam["mean_rel"]       = 0.30
tol_gam["mean_abs"]       = 0.20
tol_gam["sd_rel"]         = 0.50
tol_gam["sd_abs"]         = 0.10
tol_gam["ci_rel"]         = 0.60
tol_gam["ci_abs"]         = 0.30
tol_gam["pd_abs"]         = 0.20
tol_gam["hyper_mean_rel"] = 0.30
tol_gam["hyper_sd_rel"]   = 0.50
tol_gam["hyper_ci_rel"]   = 0.70
tol_gam["waic_abs"]       = 25.0
tol_gam["pwaic_abs"]      = 10.0

# ── M_A: gamSim Gaussian ──────────────────────────────────────────
var d_gam_sim = load(DATA_GAM_SIM)
bayes_fit_and_check("M_A", "y ~ s(x0) + s(x1) + s(x2) + s(x3)", d_gam_sim, "gaussian", refs["M_A"], tol_gam)

# ── M_K: kyphosis binomial ────────────────────────────────────────
# Re-enabled 22/11/2026. Until then Phon's Bayesian binomial GAM was
# degenerate here (intercept ≈ −12.7, WAIC ≈ 580 against INLA's 73):
# bayesian_adjust worked on the parametric block alone, so its skewness
# correction evaluated η with the intercept only, without the smooths.
#
# Compared: convergence, WAIC and p_WAIC. NOT compared: the intercept,
# which means something else in the two fits — INLA's rw2 terms sum to
# zero over their 20 inla.group values, mgcv's and Phon's smooths over the
# 83 observations, and Age is far from uniform (Phon −2.7 ± 0.5, mgcv's
# REML fit −2.75, INLA −0.47 ± 0.52). The reference's fixef block is kept
# in the JSON but emptied here; a separate bound on the intercept guards
# against the old degenerate fit.
var d_kyphosis = load(DATA_KYPHOSIS)
var ref_k = refs["M_K"]
ref_k["fixef"] = {"names": [], "post_mean": [], "post_sd": [], "ci_lower": [], "ci_upper": [], "pd": []}
var m_k = null
try
    m_k = fit("Kyphosis ~ s(Age) + s(StartVert) + s(NumVert)", d_kyphosis, "binomial", Prior())
catch err
    record_fail("M_K: fit() threw exception: " & err.message)
end
if m_k != null then
    bayes_check_fit("M_K", m_k, ref_k, tol_gam)
    var b0 = get_coef(m_k)[1]
    if b0 > -6.0 and b0 < 1.0 then
        record_pass()
    else
        record_fail("M_K intercept " & b0 & " outside [-6, 1]: degenerate fit")
    end
end

end_section()

# =====================================================================
# Consistency with the penalized fit (no INLA reference)
# =====================================================================
# With the default (weak) priors, a Bayesian GAM's parametric posterior
# should sit on the penalized REML fit it starts from: posterior SDs
# within 1% of the frequentist SEs, posterior means within 0.1 SD. Until
# 22/11/2026 bayesian_adjust read the parametric block of the covariance
# as if it were the whole matrix, so with more than one parametric
# column the SDs were garbage (vowel: 0.23 and 0.38 instead of 3.47 for
# the Gaussian model, 0 and 0.02 instead of 0.17 for the binomial one).

start_section("BAYESIAN GAM (consistency with the penalized fit)")

var d_gt = load(DATA_GAM_TEST)
var cons_forms = ["y_gauss ~ vowel + s(duration, k=8)", "y_bin ~ vowel + s(duration, k=8)"]
var cons_fams = ["gaussian", "binomial"]
for i = 1 to len(cons_forms) do
    var tag = "C" & i & " (" & cons_fams[i] & ")"
    var mf = fit(cons_forms[i], d_gt, cons_fams[i], {"fit_method": "REML"})
    var mb = fit(cons_forms[i], d_gt, cons_fams[i], Prior())
    var bf = get_coef(mf)
    for j = 1 to 3 do
        var name = mf.coef_names[j]
        check(tag & " posterior SD[" & name & "]", mb.posterior_sd[j], mf.se[j], 0.01, 0.0)
        check(tag & " posterior mean[" & name & "]", mb.posterior_mean[j], bf[j], 0.0, 0.1 * mf.se[j])
    end
end

end_section()

