# =====================================================================
# test_beta.phon — Bayesian beta-regression fit on the synthetic
# accuracy dataset. Five models match frequentist/test_beta.phon.
#
# Phonometrica reports the precision parameter as `phi(beta)` in
# hyper_names.
# =====================================================================

import stat_assert
import bayes_assert

var DATA = resolve_data_path("beta_accuracy.csv")
var REF  = resolve_sibling("reference_beta.json")

var refs_root = load_reference(REF)
var refs = refs_root["models"]
var d = load(DATA)

start_section("BAYESIAN BETA")

var tol_default = default_tolerance()
var tol_slope = default_tolerance()
tol_slope["mean_rel"]       = 0.30
tol_slope["sd_rel"]         = 0.30
tol_slope["ci_rel"]         = 0.50
tol_slope["hyper_mean_rel"] = 0.40
tol_slope["hyper_sd_rel"]   = 0.40
tol_slope["hyper_ci_rel"]   = 0.50

bayes_fit_and_check("M1", "accuracy ~ difficulty * domain", d, "beta", refs["M1"], tol_default)
bayes_fit_and_check("M2", "accuracy ~ difficulty + domain + (1|subject)", d, "beta", refs["M2"], tol_default)
bayes_fit_and_check("M3", "accuracy ~ difficulty + domain + (1+difficulty|subject)", d, "beta", refs["M3"], tol_slope)
bayes_fit_and_check("M4", "accuracy ~ difficulty + domain + (1|subject) + (1|item)", d, "beta", refs["M4"], tol_default)
bayes_fit_and_check("M5", "accuracy ~ difficulty + domain + (1+difficulty|subject) + (1|item)", d, "beta", refs["M5"], tol_slope)

end_section()
