# =====================================================================
# test_binomial.phon — validates Phonometrica's Bayesian binomial
# engine against reference_binomial.json (produced by brms HMC in
# gen_reference_binomial.R).
#
# Five models on the synthetic schwa-realisation data (5400 obs):
#   M1 — realized ~ position * style                    (interaction)
#   M2 — realized ~ position + style + (1|speaker)
#   M3 — realized ~ position + style + (1+style|speaker)
#   M4 — realized ~ position + style + (1|speaker) + (1|word)
#   M5 — realized ~ position + style + (1+style|speaker) + (1|word)
#
# Tolerance philosophy mirrors test_gaussian.phon: tolerances are
# scaled by brms' posterior SD. Logit-scale coefficients are
# typically O(1), so the absolute floor (0.02 on means) is what
# bites for tightly-constrained coefficients while the relative
# band governs the rest.
# =====================================================================

import stat_assert
import bayes_assert

var DATA = resolve_data_path("binomial_schwa.csv")
var REF  = resolve_sibling("reference_binomial.json")

var refs_root = load_reference(REF)
var refs = refs_root["models"]
var d = load(DATA)

start_section("BAYESIAN BINOMIAL")

var tol_default = default_tolerance()

var tol_slope = default_tolerance()
tol_slope["mean_rel"]       = 0.30
tol_slope["sd_rel"]         = 0.30
tol_slope["ci_rel"]         = 0.50
tol_slope["hyper_mean_rel"] = 0.40
tol_slope["hyper_sd_rel"]   = 0.40
tol_slope["hyper_ci_rel"]   = 0.50

bayes_fit_and_check("M1", "realized ~ position * style", d, "binomial", refs["M1"], tol_default)
bayes_fit_and_check("M2", "realized ~ position + style + (1|speaker)", d, "binomial", refs["M2"], tol_default)
bayes_fit_and_check("M3", "realized ~ position + style + (1+style|speaker)", d, "binomial", refs["M3"], tol_slope)
bayes_fit_and_check("M4", "realized ~ position + style + (1|speaker) + (1|word)", d, "binomial", refs["M4"], tol_default)
bayes_fit_and_check("M5", "realized ~ position + style + (1+style|speaker) + (1|word)", d, "binomial", refs["M5"], tol_slope)

end_section()
