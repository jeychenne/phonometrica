# =====================================================================
# statistics/lib/bayes_assert.phon
# =====================================================================
# Bayesian-side assertion helpers — the NEW-ENGINE port (MIGRATION_NOTES
# step 4b). Extends stat_assert.phon for the bayesian/ test suite,
# reusing its pass/fail counters, section reporting, name translation,
# lookup/check helpers and path resolution.
#
# PORT NOTE (old -> new engine):
#   - `let A = import("../lib/assert")` + `let m = Module(...)` are
#     gone: `import stat_assert` brings the shared counters
#     (stat_assert.n_passed/n_failed) and its functions are global.
#     The old aliases (m.report = A.report, ...) are unnecessary.
#   - Counters are mutated through record_pass()/record_fail(msg)
#     (owned by stat_assert) instead of `A.n_passed += 1` — the
#     printed output is identical ("    FAIL: <msg>").
#   - str(e) -> e.message.
# =====================================================================

import stat_assert

# --------------------------------------------------------------------
# Tolerance multipliers. Expressed as a multiple of brms' posterior
# SD so the comparison adapts to each coefficient's natural scale.
# --------------------------------------------------------------------

function default_tolerance()
    var t = {}
    t["mean_rel"] = 0.20
    t["mean_abs"] = 0.02
    t["sd_rel"] = 0.20
    t["sd_abs"] = 0.05
    t["ci_rel"] = 0.40
    t["ci_abs"] = 0.10
    t["pd_abs"] = 0.05
    t["hyper_mean_rel"] = 0.25
    t["hyper_mean_abs"] = 0.05
    t["hyper_sd_rel"] = 0.30
    t["hyper_sd_abs"] = 0.05
    t["hyper_ci_rel"] = 0.40
    t["hyper_ci_abs"] = 0.15
    t["waic_abs"] = 4.0
    t["waic_se_mult"] = 1.5
    t["loo_abs"] = 4.0
    t["loo_se_mult"] = 1.5
    t["pwaic_abs"] = 4.0
    t["pwaic_rel"] = 0.20
    t["ploo_abs"] = 4.0
    t["ploo_rel"] = 0.20
    return t
end

# --------------------------------------------------------------------
# scale_tolerance — convert (rel, abs) into a single absolute tol.
# --------------------------------------------------------------------

function scale_tolerance(rel as Number, atol as Number, ref_scale as Number)
    var s = abs(ref_scale)
    if s < 1.0 then
        s = 1.0
    end
    var t = rel * s
    if t < atol then
        return atol
    end
    return t
end

# --------------------------------------------------------------------
# check_within — Bayesian-style numeric check with rel/abs tolerance
# computed against an explicit ref_scale (typically brms' posterior SD).
# --------------------------------------------------------------------

function check_within(label as String, actual as Number, expected as Number, ref_scale as Number, rel as Number, atol as Number)
    var tol = scale_tolerance(rel, atol, ref_scale)
    var diff = abs(actual - expected)
    if diff <= tol then
        record_pass()
    else
        record_fail("{label}: got {actual}, expected {expected} (|d|={diff}, tol={tol})")
    end
end

# --------------------------------------------------------------------
# bayes_check_fit — generic Bayesian fit comparison.
# --------------------------------------------------------------------

function bayes_check_fit(tag as String, model as Object, reference as Object, tol as Object)
    var fit_ref = reference["fit"]

    if contains(reference, "converged") and reference["converged"] == false then
        record_note(tag & ": brms reference flagged as non-converged — skipping")
        return
    end
    if not model.converged then
        record_fail(tag & " convergence: brms converged but Phonometrica did not")
        return
    end

    check_int(tag & " nobs", model.nobs, fit_ref["nobs"])

    # WAIC.
    if contains(fit_ref, "waic") and fit_ref["waic"] != null then
        var se_w = 0.0
        if contains(fit_ref, "se_waic") and fit_ref["se_waic"] != null then
            se_w = fit_ref["se_waic"]
        end
        var atol_w = tol["waic_abs"]
        if tol["waic_se_mult"] * se_w > atol_w then
            atol_w = tol["waic_se_mult"] * se_w
        end
        check_within(tag & " WAIC", model.waic, fit_ref["waic"], 1.0, 0.0, atol_w)
    end

    # LOO-IC.
    if contains(fit_ref, "loo_ic") and fit_ref["loo_ic"] != null then
        var se_l = 0.0
        if contains(fit_ref, "se_loo") and fit_ref["se_loo"] != null then
            se_l = fit_ref["se_loo"]
        end
        var atol_l = tol["loo_abs"]
        if tol["loo_se_mult"] * se_l > atol_l then
            atol_l = tol["loo_se_mult"] * se_l
        end
        check_within(tag & " LOO-IC", model.loo_ic, fit_ref["loo_ic"], 1.0, 0.0, atol_l)
    end

    if contains(fit_ref, "p_waic") and fit_ref["p_waic"] != null then
        check_within(tag & " p_WAIC", model.p_waic, fit_ref["p_waic"], fit_ref["p_waic"], tol["pwaic_rel"], tol["pwaic_abs"])
    end
    if contains(fit_ref, "p_loo") and fit_ref["p_loo"] != null then
        check_within(tag & " p_LOO", model.p_loo, fit_ref["p_loo"], fit_ref["p_loo"], tol["ploo_rel"], tol["ploo_abs"])
    end

    # Fixed-effect posterior summaries (matched by name).
    var fxref = reference["fixef"]
    var coef_names = model.coef_names
    var post_mean = model.posterior_mean
    var post_sd = model.posterior_sd
    var ci_lo = model.ci_lower
    var ci_hi = model.ci_upper
    var pd_act = model.pd

    var fx_names = fxref["names"]
    var fx_mean = fxref["post_mean"]
    var fx_sd = fxref["post_sd"]
    var fx_lo = fxref["ci_lower"]
    var fx_hi = fxref["ci_upper"]
    var fx_pd = fxref["pd"]

    var var_names = extract_var_names(coef_names)
    var n_fx = len(fx_names)

    for i = 1 to n_fx do
        var r_name = fx_names[i]
        var phon_name = r_to_phon_name(r_name, var_names)
        var m_exp = fx_mean[i]
        var s_exp = fx_sd[i]
        var lo_exp = fx_lo[i]
        var hi_exp = fx_hi[i]
        var pd_exp = fx_pd[i]

        var m_act = lookup_or_fail(tag & " mean[" & r_name & "] lookup", coef_names, post_mean, phon_name)
        if m_act != null then
            var s_act = lookup_or_fail(tag & " sd[" & r_name & "] lookup", coef_names, post_sd, phon_name)
            var lo_act = lookup_or_fail(tag & " lo[" & r_name & "] lookup", coef_names, ci_lo, phon_name)
            var hi_act = lookup_or_fail(tag & " hi[" & r_name & "] lookup", coef_names, ci_hi, phon_name)
            var pd_act_i = lookup_or_fail(tag & " pd[" & r_name & "] lookup", coef_names, pd_act, phon_name)

            var scale_ref = s_exp

            check_within(tag & " mean[" & r_name & "]", m_act, m_exp, scale_ref, tol["mean_rel"], tol["mean_abs"])
            if s_act != null then
                check_within(tag & " sd[" & r_name & "]", s_act, s_exp, scale_ref, tol["sd_rel"], tol["sd_abs"])
            end
            if lo_act != null then
                check_within(tag & " ci_lo[" & r_name & "]", lo_act, lo_exp, scale_ref, tol["ci_rel"], tol["ci_abs"])
            end
            if hi_act != null then
                check_within(tag & " ci_hi[" & r_name & "]", hi_act, hi_exp, scale_ref, tol["ci_rel"], tol["ci_abs"])
            end
            if pd_act_i != null then
                check_within(tag & " pd[" & r_name & "]", pd_act_i, pd_exp, 1.0, 0.0, tol["pd_abs"])
            end
        end
    end

    # Hyperparameter posteriors (variance components incl. residual SD).
    if contains(reference, "hyper") and reference["hyper"] != null then
        var href = reference["hyper"]
        var h_names_ref = href["names"]
        var h_mean_ref = href["post_mean"]
        var h_sd_ref = href["post_sd"]
        var h_lo_ref = href["ci_lower"]
        var h_hi_ref = href["ci_upper"]
        var n_h = len(h_names_ref)

        var h_names_act = model.hyper_names
        var h_mean_act = model.hyper_posterior_mean
        var h_sd_act = model.hyper_posterior_sd
        var h_lo_act = model.hyper_ci_lower
        var h_hi_act = model.hyper_ci_upper

        for i = 1 to n_h do
            var r_name = h_names_ref[i]
            var phon_name = r_to_phon_ranef_name(r_name, var_names)
            var m_exp = h_mean_ref[i]
            var s_exp = h_sd_ref[i]
            var lo_exp = h_lo_ref[i]
            var hi_exp = h_hi_ref[i]

            var m_act = lookup_or_fail(tag & " hyper.mean[" & r_name & "] lookup", h_names_act, h_mean_act, phon_name)
            if m_act != null then
                var s_act = lookup_or_fail(tag & " hyper.sd[" & r_name & "] lookup", h_names_act, h_sd_act, phon_name)
                var lo_act = lookup_or_fail(tag & " hyper.lo[" & r_name & "] lookup", h_names_act, h_lo_act, phon_name)
                var hi_act = lookup_or_fail(tag & " hyper.hi[" & r_name & "] lookup", h_names_act, h_hi_act, phon_name)

                var scale_ref = s_exp
                if scale_ref == null or scale_ref == 0 then
                    scale_ref = m_exp
                end

                check_within(tag & " hyper.mean[" & r_name & "]", m_act, m_exp, scale_ref, tol["hyper_mean_rel"], tol["hyper_mean_abs"])
                if s_act != null then
                    check_within(tag & " hyper.sd[" & r_name & "]", s_act, s_exp, scale_ref, tol["hyper_sd_rel"], tol["hyper_sd_abs"])
                end
                if lo_act != null and lo_exp != null then
                    check_within(tag & " hyper.lo[" & r_name & "]", lo_act, lo_exp, scale_ref, tol["hyper_ci_rel"], tol["hyper_ci_abs"])
                end
                if hi_act != null and hi_exp != null then
                    check_within(tag & " hyper.hi[" & r_name & "]", hi_act, hi_exp, scale_ref, tol["hyper_ci_rel"], tol["hyper_ci_abs"])
                end
            end
        end
    end
end

# --------------------------------------------------------------------
# bayes_fit_and_check — fit a Bayesian model in a try/catch wrapper,
# then run bayes_check_fit. The prior is constructed inside this
# helper: the brms-side reference was generated against default
# priors, so the phon-side fit must use defaults too.
# --------------------------------------------------------------------

function bayes_fit_and_check(tag as String, formula as String, data as Object, family as String, reference as Object, tol as Object)
    if reference == null then
        record_note(tag & ": no reference entry — skipping")
        return
    end
    if tol == null then
        tol = default_tolerance()
    end

    var model = null
    try
        var prior = Prior()
        if family == "gaussian" then
            model = fit(formula, data, prior)
        else
            model = fit(formula, data, family, prior)
        end
    catch e
        record_fail(tag & ": fit() threw exception: " & e.message)
        return
    end

    bayes_check_fit(tag, model, reference, tol)
end
