# =====================================================================
# statistics/lib/assert.phon
# =====================================================================
# Shared assertion helpers for the Phonometrica statistics validation
# suite. Imported by every test_<family>.phon under
# statistics/<engine>/.
#
# Usage in a test file:
#
#     let A = import("../lib/assert")
#     A.start_section("GAUSSIAN")
#     A.fit_and_check("M1", "f1 ~ vowel * gender", d, "gaussian",
#                     refs["M1"], 1e-6, 1e-5, 1e-5)
#     ...
#     A.end_section()
#     A.report()
#
# `import` caches the loaded module, so every test file that imports
# this file shares the same Module instance and the same pass/fail
# counters. A run_all.phon driver can therefore import every
# test_*.phon in turn and have one accumulated tally.
#
# Three properties make this harness robust to messy real-world
# references:
#
#   1. fit_and_check wraps the actual fit() call in try/catch — if
#      Phonometrica's optimiser blows up on one model (e.g. an L-BFGS
#      non-finite state on a boundary fit), the failure is recorded
#      and the suite continues with the next model.
#
#   2. check_fit skips any reference field whose value is null. R
#      legitimately writes null when a fit didn't converge; we still
#      want to compare the fixed-effect estimates and SEs that R
#      *did* produce.
#
#   3. ranef arrays are tolerated in both forms — JSON arrays
#      (multiple terms) and JSON scalars (single term, the
#      auto_unbox=TRUE artifact). The helper coerce_to_list below
#      handles the singleton case.
# =====================================================================

let m = Module("assert")

# --------------------------------------------------------------------
# Counters & section state.
# --------------------------------------------------------------------

m.n_passed = 0
m.n_failed = 0
m.cur_section = ""
m.section_failed_baseline = 0

m.reset_counters = function ()
    m.n_passed = 0
    m.n_failed = 0
    m.cur_section = ""
    m.section_failed_baseline = 0
end

m.start_section = function (name as String)
    m.cur_section = name
    m.section_failed_baseline = m.n_failed
    print ""
    print "----------------------------------------------------------------------"
    print " ", name
    print "----------------------------------------------------------------------"
end

m.end_section = function ()
    let in_section = m.n_failed - m.section_failed_baseline
    if in_section == 0 then
        print "  [", m.cur_section, "] OK"
    else
        print "  [", m.cur_section, "] ", in_section, " failure(s)"
    end
    m.cur_section = ""
end

# --------------------------------------------------------------------
# Pass/fail recorders.
# --------------------------------------------------------------------

m.record_pass = function ()
    m.n_passed += 1
end

m.record_fail = function (msg as String)
    m.n_failed += 1
    print "    FAIL: ", msg
end

m.record_note = function (msg as String)
    # Information that is neither pass nor fail; printed with a softer
    # prefix so the suite output still summarises cleanly.
    print "    NOTE: ", msg
end

# --------------------------------------------------------------------
# Approximate equality. Returns true if either tolerance is met:
#   |actual - expected| <= atol
#   |actual - expected| <= rtol * max(1, |expected|)
# The floor of 1 in the relative branch keeps the tolerance from
# vanishing for tiny references.
# --------------------------------------------------------------------

m.approx_eq = function (actual as Number, expected as Number, rtol as Number, atol as Number)
    let diff = abs(actual - expected)
    let scale = abs(expected)
    if scale < 1.0 then
        scale = 1.0
    end
    return diff <= atol or diff <= rtol * scale
end

# --------------------------------------------------------------------
# check — numeric comparison with tolerance. Records a pass or
# failure and prints a useful message on failure.
# --------------------------------------------------------------------

m.check = function (label as String, actual as Number, expected as Number, rtol as Number, atol as Number)
    let diff = abs(actual - expected)
    let scale = abs(expected)
    if scale < 1.0 then
        scale = 1.0
    end
    if diff <= atol or diff <= rtol * scale then
        m.n_passed += 1
    else
        m.n_failed += 1
        print "    FAIL: ", label, ": got ", actual, ", expected ", expected, " (rtol=", rtol, ", atol=", atol, ")"
    end
end

# Exact equality for integer-valued quantities (nobs, ncoef, ngroup …).
m.check_int = function (label as String, actual as Number, expected as Number)
    if actual == expected then
        m.n_passed += 1
    else
        m.n_failed += 1
        print "    FAIL: ", label, ": got ", actual, ", expected ", expected
    end
end

# --------------------------------------------------------------------
# coerce_to_list — wraps a scalar in a 1-element list, leaves a list
# alone. JSON references produced with jsonlite::toJSON(auto_unbox =
# TRUE) collapse single-element vectors to scalars (so a "ranef"
# block with one random intercept has names = "sd(...)" and
# sd = <number>, not arrays). This helper hides that wrinkle from the
# rest of the harness.
# --------------------------------------------------------------------

m.coerce_to_list = function (x as Object)
    if type(x) == type([]) then
        return x
    end
    return [x]
end

# --------------------------------------------------------------------
# is_boundary_reference — true if R's reference fit is at a boundary
# or didn't converge, in which case its numeric values aren't a
# meaningful validation target. Two signals:
#
#   * converged == false (glmmTMB explicitly flagged the fit)
#   * loglik   == null   (R refused to compute it; usually means
#                         a degenerate boundary fit even when the
#                         optimizer technically returned)
#
# When this returns true, check_fit skips the coefficient and ranef
# comparisons (only the sample size and any non-null fit summaries
# are still checked), and fit_and_check downgrades engine exceptions
# from FAIL to NOTE — the rationale being that a hard model where
# R also struggled isn't a regression signal.
# --------------------------------------------------------------------

m.is_boundary_reference = function (reference as Object)
    if contains(reference, "converged") and reference["converged"] != null then
        if reference["converged"] == false then
            return true
        end
    end
    if contains(reference, "fit") and contains(reference["fit"], "loglik") then
        if reference["fit"]["loglik"] == null then
            return true
        end
    end
    return false
end

# --------------------------------------------------------------------
# R-to-Phonometrica coefficient-name translation.
#
# R names categorical coefficients as paste0(var, level) and the
# intercept as "(Intercept)". Phonometrica uses brackets and no parens:
#
#   "(Intercept)"           -> "Intercept"
#   "voweli"                -> "vowel[i]"
#   "voweli:genderM"        -> "vowel[i]:gender[M]"
#   "sd((Intercept)|s)"     -> "sd(Intercept|s)"
#   "sd(voweli|s)"          -> "sd(vowel[i]|s)"
#   "sd(residual)"          -> "sd(residual)"  (unchanged)
#
# Names that are *already* in Phonometrica format pass through unchanged,
# so the harness works regardless of which side did the translation.
#
# Translation needs to know the variable names to split paste0(var, level)
# correctly. We extract those from Phonometrica's coef_names.
# --------------------------------------------------------------------

m.extract_var_names = function (coef_names as List)
    # Walk Phonometrica coef_names. Each name like "vowel[i]" or
    # "vowel[i]:gender[M]" contributes the variable prefix (everything
    # before the first "[") to the set. "Intercept" and continuous
    # variables (no brackets) contribute nothing.
    let vars = []
    for k = 1 to len(coef_names) do
        let parts = split(coef_names[k], ":")
        for p = 1 to len(parts) do
            let part = parts[p]
            let bracket = find(part, "[")
            if bracket > 0 then
                let v = slice(part, 1, bracket - 1)
                if find(vars, v) == 0 then
                    append(vars, v)
                end
            end
        end
    end
    return vars
end

m.r_to_phon_term = function (part as String, var_names as List)
    # Translate one R-format coefficient name fragment (no colons).
    # Pass-through cases (already in Phonometrica format):
    if part == "Intercept" then
        return part
    end
    if contains(part, "[") then
        return part
    end
    # R's "(Intercept)" -> Phonometrica's "Intercept"
    if part == "(Intercept)" then
        return "Intercept"
    end
    # R's paste0(var, level) -> Phonometrica's "var[level]". Find the
    # longest variable prefix that matches; the rest is the level.
    let best = ""
    let best_len = 0
    for v = 1 to len(var_names) do
        let vn = var_names[v]
        if starts_with(part, vn) and len(vn) > best_len then
            best = vn
            best_len = len(vn)
        end
    end
    if best_len > 0 then
        let level = slice(part, best_len + 1, len(part) - best_len)
        return best & "[" & level & "]"
    end
    # No variable prefix matched — must be a continuous variable name.
    return part
end

m.r_to_phon_name = function (r_name as String, var_names as List)
    # Translate an R-format fixed-effect name. Splits on ":" for
    # interactions, translates each component, rejoins.
    let parts = split(r_name, ":")
    let result = ""
    for i = 1 to len(parts) do
        if i > 1 then
            result = result & ":"
        end
        result = result & m.r_to_phon_term(parts[i], var_names)
    end
    return result
end

m.r_to_phon_ranef_name = function (r_name as String, var_names as List)
    # Translate an R-format random-effect name "sd(<term>|<group>)" to
    # Phonometrica's "sd(<phon_term>|<group>)". "sd(residual)" is left
    # alone — both engines use the same string for it.
    if not starts_with(r_name, "sd(") then
        return r_name
    end
    if r_name == "sd(residual)" then
        return r_name
    end
    # Strip "sd(" prefix and trailing ")".
    let inner = slice(r_name, 4, len(r_name) - 4)
    let pipe_pos = find(inner, "|")
    if pipe_pos == 0 then
        return r_name
    end
    let term  = slice(inner, 1, pipe_pos - 1)
    let group = slice(inner, pipe_pos + 1, len(inner) - pipe_pos)
    let phon_term = m.r_to_phon_name(term, var_names)
    return "sd(" & phon_term & "|" & group & ")"
end

# --------------------------------------------------------------------
# lookup_or_fail — find a value by name in two parallel arrays.
# Returns the value if found; otherwise records a failure and
# returns null. Used to match coefficients (and ranef SDs) by name
# across engines, where the row order may differ.
# --------------------------------------------------------------------

m.lookup_or_fail = function (label as String, names as List, values as Object, target as String)
    let i = find(names, target)
    if i == 0 then
        m.n_failed += 1
        print "    FAIL: ", label, ": name not found: '", target, "'"
        return null
    end
    return values[i]
end

# --------------------------------------------------------------------
# check_optional — common pattern: if `key` is present in `tbl` and
# its value is non-null, compare against actual. Otherwise silently
# skip. Used by check_fit for fields like loglik, aic, etc., that
# legitimately come back null when the reference fit didn't converge.
# --------------------------------------------------------------------

m.check_optional = function (label as String, actual as Number, tbl as Object, key as String, rtol as Number, atol as Number)
    if not contains(tbl, key) then
        return
    end
    let expected = tbl[key]
    if expected == null then
        return
    end
    m.check(label, actual, expected, rtol, atol)
end

# --------------------------------------------------------------------
# check_fit — generic fit comparison. Compares a fitted Model
# against a reference JSON object loaded from the per-family
# reference file.
#
# Reference shape (one model entry):
#
#   "converged": true / false,            (optional; default true)
#   "fit": {
#     "nobs": ...,
#     "loglik" / "aic" / "bic" / ...      (any subset; null skipped)
#   },
#   "fixef": {
#     "names":    [ ... ],
#     "estimate": [ ... ],                (null entries skipped)
#     "se":       [ ... ]                 (null entries skipped)
#   },
#   "ranef": null  OR
#   { "names": [...] | "sd(...)" ,        (singleton OK)
#     "sd":    [...] |  <number> }
#
# Tolerances:
#   rtol_fit    – scalar fit summaries (loglik, AIC, BIC, RSE, …)
#   rtol_coef   – fixed-effect estimates and SEs
#   rtol_ranef  – random-effect SDs
# --------------------------------------------------------------------

m.check_fit = function (tag as String, model as Object, reference as Object, rtol_fit as Number, rtol_coef as Number, rtol_ranef as Number)
    let fit_ref = reference["fit"]
    let boundary = m.is_boundary_reference(reference)

    # ── Convergence policy. If R converged cleanly, Phonometrica is
    #    expected to as well (real regression signal if it doesn't).
    #    If R is at a boundary, we don't fail on Phonometrica's
    #    convergence flag either way.
    if not boundary and not model.converged then
        m.record_fail(tag & " convergence: R converged but Phonometrica did not")
    end

    # ── Sample size: must match exactly. ──
    m.check_int(tag & " nobs", model.nobs, fit_ref["nobs"])

    # ── Fit summaries: skip null entries. ──
    m.check_optional(tag & " loglik", model.loglik, fit_ref, "loglik", rtol_fit, 0.001)
    m.check_optional(tag & " AIC",    model.aic,    fit_ref, "aic",    rtol_fit, 0.01)
    m.check_optional(tag & " BIC",    model.bic,    fit_ref, "bic",    rtol_fit, 0.01)
    m.check_optional(tag & " RSE",    model.rse,    fit_ref, "rse",    rtol_fit, 0.001)
    m.check_optional(tag & " R²",     model.r2,     fit_ref, "r2",     rtol_fit, 0.0001)
    m.check_optional(tag & " adj.R²", model.adj_r2, fit_ref, "adj_r2", rtol_fit, 0.0001)
    m.check_optional(tag & " theta",  model.theta,  fit_ref, "theta",  rtol_fit, 0.001)
    m.check_optional(tag & " phi",    model.phi,    fit_ref, "phi",    rtol_fit, 0.001)
    m.check_optional(tag & " sigma",  model.sigma,  fit_ref, "sigma",  rtol_fit, 0.001)
    m.check_optional(tag & " nu",     model.nu,     fit_ref, "nu",     rtol_fit, 0.001)

    # ── Boundary references: R's coefficient/SE/SD values aren't a
    #    meaningful validation target (the fit is degenerate), so we
    #    stop here. We've still verified Phonometrica produces a
    #    finite fit with the right sample size.
    if boundary then
        m.record_note(tag & ": R reference is at a boundary (converged=false or loglik=null) — skipping coefficient and ranef comparisons")
        return
    end

    # ── Fixed-effect estimates and SEs (matched by name). ──
    let fxref = reference["fixef"]
    let coef_names = model.coef_names
    let beta = get_coef(model)
    let se   = model.se
    let fx_names = fxref["names"]
    let fx_est   = fxref["estimate"]
    let fx_se    = fxref["se"]
    let n_fx = len(fx_names)

    # Build the variable-name list once. Used to translate R-format
    # JSON names (paste0(var, level)) into Phonometrica's "var[level]"
    # form. Names already in Phonometrica format pass through unchanged.
    let var_names = m.extract_var_names(coef_names)

    for i = 1 to n_fx do
        let r_name    = fx_names[i]
        let phon_name = m.r_to_phon_name(r_name, var_names)
        let b_exp = fx_est[i]
        let s_exp = fx_se[i]

        let b_act = m.lookup_or_fail(tag & " β[" & r_name & "] lookup", coef_names, beta, phon_name)
        let s_act = m.lookup_or_fail(tag & " SE[" & r_name & "] lookup", coef_names, se,   phon_name)
        if b_act != null and b_exp != null then
            m.check(tag & " β[" & r_name & "]",  b_act, b_exp, rtol_coef, 0.0001)
        end
        if s_act != null and s_exp != null then
            m.check(tag & " SE[" & r_name & "]", s_act, s_exp, rtol_coef, 0.0001)
        end
    end

    # ── Random-effect SDs (mixed only). ──
    if contains(reference, "ranef") and reference["ranef"] != null then
        let raneffs = reference["ranef"]
        let ref_names = m.coerce_to_list(raneffs["names"])
        let ref_sds   = m.coerce_to_list(raneffs["sd"])
        let act_names = model.ranef_names
        let act_sds   = model.ranef_sd
        let n_re = len(ref_names)
        for i = 1 to n_re do
            let r_name    = ref_names[i]
            let phon_name = m.r_to_phon_ranef_name(r_name, var_names)
            let s_exp = ref_sds[i]
            let s_act = m.lookup_or_fail(tag & " ranef[" & r_name & "] lookup", act_names, act_sds, phon_name)
            if s_act != null and s_exp != null then
                # 1.0 absolute floor lets a near-zero RE SD pass even
                # if R reports a numerically different tiny value.
                m.check(tag & " " & r_name, s_act, s_exp, rtol_ranef, 1.0)
            end
        end
    end
end

# --------------------------------------------------------------------
# fit_and_check — fit a model in a try/catch wrapper, then run
# check_fit. If the fit throws, the failure is recorded and the
# function returns cleanly so the rest of the suite continues.
# This is the recommended entry point in test_<family>.phon files;
# direct fit() + check_fit() is fine when you want to inspect the
# model object outside of the helper (e.g. for debug printing).
#
# `family` is always a string. "gaussian" is treated specially —
# Phonometrica accepts the 2-arg fit() form for Gaussian, and we
# use it to keep the path short.
# --------------------------------------------------------------------

m.fit_and_check = function (tag as String, formula as String, data as Object, family as String, reference as Object, rtol_fit as Number, rtol_coef as Number, rtol_ranef as Number)
    if reference == null then
        m.record_note(tag & ": no reference entry — skipping")
        return
    end

    let boundary = m.is_boundary_reference(reference)

    let model = null
    try
        if family == "gaussian" then
            model = fit(formula, data)
        else
            model = fit(formula, data, family)
        end
    catch e
        if boundary then
            # R also struggled here — engine wobble on the hard case
            # isn't a regression signal. Log it visibly as a note so
            # the user can see Phonometrica's behaviour, then move on.
            m.record_note(tag & ": fit() threw on boundary case (R reference also degenerate): " & str(e))
        else
            m.record_fail(tag & ": fit() threw exception: " & str(e))
        end
        return
    end

    m.check_fit(tag, model, reference, rtol_fit, rtol_coef, rtol_ranef)
end

# --------------------------------------------------------------------
# Path-resolution helpers built on the get_script_path() runtime
# builtin (added May 2026). Tests do NOT contain absolute paths;
# instead they ask "where am I?" and build relative paths from
# there. join_path uses the host's native separator, so the same
# scripts work on Linux, macOS, and Windows.
#
# Layout assumption (see test/README.md):
#
#   test/
#     data/<csv>
#     statistics/
#       lib/assert.phon
#       frequentist/
#         test_<family>.phon
#         reference_<family>.json
#
# The data dir is two levels up from a test_*.phon file.
# --------------------------------------------------------------------

m.script_dir = function ()
    return get_directory(get_script_path())
end

m.resolve_sibling = function (rel as String)
    return join_path(get_directory(get_script_path()), rel)
end

m.resolve_data_path = function (rel as String)
    let here = get_directory(get_script_path())
    let up   = get_directory(here)              # one level up
    let root = get_directory(up)                # two levels up (test/)
    return join_path(join_path(root, "data"), rel)
end

# --------------------------------------------------------------------
# check_gam — GAM-specific fit comparison.
#
# Reference shape (one GAM model entry):
#
#   "fit": { "nobs", "loglik", "aic", "r2_adj", "scale" }
#   "fixef": { "names", "estimate", "se" }   (same shape as check_fit)
#   "smooths": {                              (parallel arrays, one entry
#     "names": ["s(duration)", ...],           per s() term in formula order)
#     "edf":   [3.5, ...],
#     "F":     [42.3, ...],                   (F for Gaussian; Chi.sq for GLM)
#     "p":     [0.0001, ...]
#   }

m.check_gam = function (tag as String, model as Object, reference as Object, rtol_fit as Number, rtol_coef as Number, rtol_edf as Number)
    let fit_ref = reference["fit"]

    m.check_int(tag & " nobs", model.nobs, fit_ref["nobs"])
    m.check_optional(tag & " loglik", model.loglik, fit_ref, "loglik", rtol_fit, 0.01)
    m.check_optional(tag & " AIC",    model.aic,    fit_ref, "aic",    rtol_fit, 0.01)
    m.check_optional(tag & " adj.R²", model.adj_r2, fit_ref, "r2_adj", rtol_fit, 0.001)
    m.check_optional(tag & " scale",  model.rse,    fit_ref, "scale",  rtol_fit, 0.001)

    # ── Fixed-effect estimates ──
    if contains(reference, "fixef") and reference["fixef"] != null then
        let fxref     = reference["fixef"]
        let fx_names  = fxref["names"]
        let fx_est    = fxref["estimate"]
        let fx_se     = fxref["se"]
        let coef_names = model.coef_names
        let beta      = get_coef(model)
        let se        = model.se
        let var_names = m.extract_var_names(coef_names)
        let n_fx = len(fx_names)
        for i = 1 to n_fx do
            let r_name    = fx_names[i]
            let phon_name = m.r_to_phon_name(r_name, var_names)
            let b_exp = fx_est[i]
            let s_exp = fx_se[i]
            let b_act = m.lookup_or_fail(tag & " β[" & r_name & "] lookup", coef_names, beta, phon_name)
            let s_act = m.lookup_or_fail(tag & " SE[" & r_name & "] lookup", coef_names, se, phon_name)
            if b_act != null and b_exp != null then
                m.check(tag & " β[" & r_name & "]", b_act, b_exp, rtol_coef, 0.001)
            end
            if s_act != null and s_exp != null then
                m.check(tag & " SE[" & r_name & "]", s_act, s_exp, rtol_coef, 0.001)
            end
        end
    end

    # ── Smooth terms: parallel arrays ──
    if contains(reference, "smooths") and reference["smooths"] != null then
        let sm_ref   = reference["smooths"]
        let ref_names = sm_ref["names"]
        let ref_edf   = sm_ref["edf"]
        let ref_F     = sm_ref["F"]
        let ref_p     = sm_ref["p"]
        let n_ref = len(ref_names)

        if model.n_smooth != n_ref then
            m.record_fail(tag & " smooth count: got " & model.n_smooth & ", expected " & n_ref)
        else
            let act_edf = model.smooth_edf
            let act_F   = model.smooth_F
            let act_p   = model.smooth_p
            for i = 1 to n_ref do
                let sname = ref_names[i]
                m.check(tag & " EDF[" & sname & "]", act_edf[i], ref_edf[i], rtol_edf, 0.2)
                m.check(tag & " F[" & sname & "]",   act_F[i],   ref_F[i],   rtol_edf * 2, 1.0)
            end
        end
    end
end

# fit_and_check_gam — fit a GAM in a try/catch wrapper, then run check_gam.
m.fit_and_check_gam = function (tag as String, formula as String, data as Object, family as String, reference as Object, rtol_fit as Number, rtol_coef as Number, rtol_edf as Number)
    let model = null
    try
        model = fit(formula, data, family)
    catch err
        m.record_fail(tag & ": fit() threw exception: " & err)
        return
    end
    if model == null then
        m.record_fail(tag & ": fit() returned null")
        return
    end
    m.check_gam(tag, model, reference, rtol_fit, rtol_coef, rtol_edf)
end

# --------------------------------------------------------------------
# load_reference — read a JSON reference file. Convenience wrapper
# over read_file + load_json.
# --------------------------------------------------------------------

m.load_reference = function (path as String)
    let txt = read_file(path)
    return load_json(txt)
end

# --------------------------------------------------------------------
# report — final tally. Returns nothing; the caller typically does
#   assert A.n_failed == 0, "test suite has failures"
# right after.
# --------------------------------------------------------------------

m.report = function ()
    print ""
    print "======================================================================"
    print " Results: ", m.n_passed, " passed, ", m.n_failed, " failed"
    print "======================================================================"
end

return m
