# Class declarations: value, ref, inheritance, open; fields and methods.
class Interval
    field xmin as Float             # typed, default-initialized (no explicit value)
    field xmax as Float = 0         # typed, with a default
    field text                      # untyped (implicitly Object), default-initialized
    field label = ""                # untyped, with a default

    method init(xmin as Float, xmax as Float, text as String)
        this.xmin = xmin
        this.xmax = xmax
        this.text = text
    end

    method to_string() as String
        return "[{this.xmin}, {this.xmax}] {this.text}"
    end
end

ref class Tier
    field intervals as List = []

    method iterate()
        return iterate(this.intervals)
    end
end

class PointTier is Tier
    field points as List = []
end

open class Extensible
    field value as Integer = 0

    # Field accessors: read-only computed, read/write computed, validated storage.
    field squared as Integer
        get
            return this.value * this.value
        end
    end
    field scaled as Integer
        get
            return this.value * 10
        end
        set(v as Integer)
            this.value = v / 10
        end
    end
    field bounded as Integer = 0
        set(v as Integer)
            this.bounded = v
        end
    end
end

local class Cursor
    field pos as Integer = 0
end

# The full modifier stack, in canonical order: local open ref class.
local open ref class Handle is Resource
    field id as Integer = 0
end
