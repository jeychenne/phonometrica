# =====================================================================
# Stress test: break / continue interaction with try/catch.
#
# The lowerer emits one POPTRY per `try` whose body contains a `break`
# or `continue` that exits one or more enclosing tries within the
# current loop (finally-inlining, DEVIATIONS M5 Errors #5). If that
# count is wrong (off by one, missing, or extra) the runtime's handler
# stack ends up out of sync with the static program structure. This
# file is designed to detect any such mismatch.
#
# Detection strategy. After each break/continue, we throw a value whose
# ONLY plausible handler is one OUTSIDE the function that did the
# break/continue. If the inner handler was correctly popped, the throw
# escapes the function and the OUTER catch sees the value. If the inner
# handler was NOT popped, the stale handler is still on top of the
# runtime's handler stack and will catch the throw, producing a
# different observable (a sentinel return value).
#
# PORT NOTE (old -> new engine): `let` -> `var`; assert/print/str are
# calls (str -> to_string); only Error values are thrown, so the caught
# observable is `e.message`; `foreach v in xs do` -> `for v in xs do`.
# Loop/try shapes are otherwise unchanged. See MIGRATION_NOTES.md.
# =====================================================================

print("==== break/continue x try/catch stress test ====")


# ---------------------------------------------------------------------
# Test 1. Single try inside while: break must pop one handler.
# ---------------------------------------------------------------------
local function t1_break_while()
    var i = 0
    while i < 5 do
        try
            if i == 2 then
                break
            end
            i = i + 1
        catch e
            return "INNER_FIRED"
        end
    end
    # If the inner handler was popped at break, this throw escapes.
    # If not, the stale inner catch fires and we return "INNER_FIRED".
    throw Error("after-loop")
end

var r1 = "init"
try
    t1_break_while()
catch e
    r1 = e.message
end
assert(r1 == "after-loop", "T1 break-while: expected \"after-loop\", got " & r1)
print("T1 break inside while: OK")


# ---------------------------------------------------------------------
# Test 2. Single try inside while: continue must pop one handler per
# iteration.
# ---------------------------------------------------------------------
local function t2_continue_while()
    var i = 0
    while i < 5 do
        try
            i = i + 1
            continue
        catch e
            return "INNER_FIRED"
        end
    end
    throw Error("after-loop")
end

var r2 = "init"
try
    t2_continue_while()
catch e
    r2 = e.message
end
assert(r2 == "after-loop", "T2 continue-while: expected \"after-loop\", got " & r2)
print("T2 continue inside while: OK")


# ---------------------------------------------------------------------
# Test 3. Nested try inside while: break must pop TWO handlers.
# ---------------------------------------------------------------------
local function t3_break_nested_try_in_while()
    var i = 0
    while i < 5 do
        try
            try
                if i == 2 then
                    break
                end
                i = i + 1
            catch e
                return "INNER_FIRED"
            end
        catch e
            return "OUTER_FIRED"
        end
    end
    throw Error("after-loop")
end

var r3 = "init"
try
    t3_break_nested_try_in_while()
catch e
    r3 = e.message
end
assert(r3 == "after-loop", "T3 break-nested-while: expected \"after-loop\", got " & r3)
print("T3 break out of doubly-nested try in while: OK")


# ---------------------------------------------------------------------
# Test 4. Nested try inside while: continue must pop TWO handlers.
# ---------------------------------------------------------------------
local function t4_continue_nested_try_in_while()
    var i = 0
    while i < 5 do
        try
            try
                i = i + 1
                continue
            catch e
                return "INNER_FIRED"
            end
        catch e
            return "OUTER_FIRED"
        end
    end
    throw Error("after-loop")
end

var r4 = "init"
try
    t4_continue_nested_try_in_while()
catch e
    r4 = e.message
end
assert(r4 == "after-loop", "T4 continue-nested-while: expected \"after-loop\", got " & r4)
print("T4 continue out of doubly-nested try in while: OK")


# ---------------------------------------------------------------------
# Test 5. try OUTSIDE the loop, no try inside the loop: break pops
# nothing; the outer try's handler must remain live after break.
# ---------------------------------------------------------------------
local function t5_break_outer_try_only()
    try
        var i = 0
        while i < 5 do
            if i == 2 then
                break
            end
            i = i + 1
        end
        # The outer try is still active — this throw must hit it.
        throw Error("outer-caught")
    catch e
        return e.message
    end
end

assert(t5_break_outer_try_only() == "outer-caught", "T5 break with outer try only failed")
print("T5 break with outer try only (zero pops expected): OK")


# ---------------------------------------------------------------------
# Test 6. try OUTSIDE the loop AND try INSIDE the loop: break pops just
# the inner one. A wrong count of 2 would pop the outer too, and the
# post-loop throw would not be caught.
# ---------------------------------------------------------------------
local function t6_break_with_outer_try()
    try
        var i = 0
        while i < 5 do
            try
                if i == 2 then
                    break
                end
                i = i + 1
            catch e
                return "INNER_FIRED"
            end
        end
        throw Error("outer-caught")
    catch e
        return e.message
    end
end

assert(t6_break_with_outer_try() == "outer-caught", "T6 break with outer try failed")
print("T6 break with outer try + inner try in loop: OK")


# ---------------------------------------------------------------------
# Test 7. for-loop variant. Same logic as T1 but with a `for`.
# ---------------------------------------------------------------------
local function t7_break_for()
    for i = 1 to 10 do
        try
            if i == 3 then
                break
            end
        catch e
            return "INNER_FIRED"
        end
    end
    throw Error("after-loop")
end

var r7 = "init"
try
    t7_break_for()
catch e
    r7 = e.message
end
assert(r7 == "after-loop", "T7 break-for: expected \"after-loop\", got " & r7)
print("T7 break inside for: OK")


# ---------------------------------------------------------------------
# Test 8. for-loop continue variant.
# ---------------------------------------------------------------------
local function t8_continue_for()
    for i = 1 to 5 do
        try
            continue
        catch e
            return "INNER_FIRED"
        end
    end
    throw Error("after-loop")
end

var r8 = "init"
try
    t8_continue_for()
catch e
    r8 = e.message
end
assert(r8 == "after-loop", "T8 continue-for: expected \"after-loop\", got " & r8)
print("T8 continue inside for: OK")


# ---------------------------------------------------------------------
# Test 9. for-in (iteration) variant.
# ---------------------------------------------------------------------
local function t9_break_for_in()
    for v in [10, 20, 30, 40] do
        try
            if v == 20 then
                break
            end
        catch e
            return "INNER_FIRED"
        end
    end
    throw Error("after-loop")
end

var r9 = "init"
try
    t9_break_for_in()
catch e
    r9 = e.message
end
assert(r9 == "after-loop", "T9 break-for-in: expected \"after-loop\", got " & r9)
print("T9 break inside for-in: OK")


# ---------------------------------------------------------------------
# Test 10. repeat-until variant.
# ---------------------------------------------------------------------
local function t10_break_repeat()
    var i = 0
    repeat
        try
            if i == 2 then
                break
            end
            i = i + 1
        catch e
            return "INNER_FIRED"
        end
    until i >= 5
    throw Error("after-loop")
end

var r10 = "init"
try
    t10_break_repeat()
catch e
    r10 = e.message
end
assert(r10 == "after-loop", "T10 break-repeat: expected \"after-loop\", got " & r10)
print("T10 break inside repeat-until: OK")


# ---------------------------------------------------------------------
# Test 11. Nested loops: break out of inner loop's try, outer loop
# must continue normally (its own handlers, if any, must be intact).
# ---------------------------------------------------------------------
local function t11_break_inner_loop_only()
    var outer_count = 0
    var i = 0
    while i < 3 do
        var j = 0
        while j < 5 do
            try
                if j == 2 then
                    break
                end
                j = j + 1
            catch e
                return "INNER_FIRED"
            end
        end
        outer_count = outer_count + 1
        i = i + 1
    end
    return outer_count
end

assert(t11_break_inner_loop_only() == 3, "T11 nested-loops break failed")
print("T11 break inner only, outer loop completes: OK")


# ---------------------------------------------------------------------
# Test 12. continue inside loop, then a real `throw` on a later
# iteration. Confirms the per-iteration push/pop of handlers is
# correctly cycled.
# ---------------------------------------------------------------------
local function t12_continue_then_throw()
    var i = 0
    var caught = "none"
    while i < 5 do
        try
            i = i + 1
            if i == 3 then
                throw Error("iter3")
            end
            continue
        catch e
            caught = e.message
        end
    end
    return caught
end

assert(t12_continue_then_throw() == "iter3", "T12 continue+throw failed")
print("T12 continue then throw on later iteration: OK")


# ---------------------------------------------------------------------
# Test 13. break from inner of try-inside-try, where ONLY the inner
# `try` is inside the loop (outer try wraps the loop itself).
# ---------------------------------------------------------------------
local function t13_break_inner_of_two_tries()
    try
        for i = 1 to 5 do
            try
                if i == 3 then
                    break
                end
            catch e
                return "INNER_FIRED"
            end
        end
        # Outer try still active.
        throw Error("outer-caught")
    catch e
        return e.message
    end
end

assert(t13_break_inner_of_two_tries() == "outer-caught", "T13 break inner-of-two failed")
print("T13 break inner-of-two-tries (one inside loop, one outside): OK")


# ---------------------------------------------------------------------
# Test 14. Triple-nested try inside loop: break must pop THREE.
# ---------------------------------------------------------------------
local function t14_break_triple_nested()
    var i = 0
    while i < 5 do
        try
            try
                try
                    if i == 1 then
                        break
                    end
                    i = i + 1
                catch e
                    return "L3_FIRED"
                end
            catch e
                return "L2_FIRED"
            end
        catch e
            return "L1_FIRED"
        end
    end
    throw Error("after-loop")
end

var r14 = "init"
try
    t14_break_triple_nested()
catch e
    r14 = e.message
end
assert(r14 == "after-loop", "T14 break triple-nested: expected \"after-loop\", got " & r14)
print("T14 break out of triple-nested try in loop: OK")


print("==== ALL break/continue x try/catch TESTS PASSED ====")
