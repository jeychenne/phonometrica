# =====================================================================
# test_compound_assignment.phon
# =====================================================================
# Regression suite for compound-assignment lowering in the compiler.
#
# History. The original suite pinned a fix for `m.field += value` on the
# OLD engine's first-class Module objects, which the new language does
# not have (a module is not a runtime value). The equivalent surface in
# the new language is exercised instead: module bindings, locals,
# upvalues, Table/List subscripts, and (explicit-form) instance fields.
#
# PORT NOTE (old -> new engine):
#   - `Module("test")` and first-class module values do not exist; the
#     dot-notation tests now target a user class instance where the old
#     suite targeted a Module.
#   - Compound assignment on an OBJECT FIELD (`obj.field += v`) is a
#     compile error in the new engine ("invalid compound-assignment
#     target"); only the explicit form `obj.field = obj.field + v`
#     works. Gap-logged in MIGRATION_NOTES.md.
#   - The operator set is `+= -= *= /= &=` (design §12). The old `^=`
#     and `%=` no longer exist (`%` is not an operator; `mod` has no
#     compound form). Their blocks use the explicit form.
# =====================================================================

print("==== compound assignment ====")

# 1. += on a module binding, repeated, mutated from a function.
print("--- 1. module binding n += 1 (x3) ---")
var mn = 0
local function bump_mn()
    mn += 1
end
bump_mn()
bump_mn()
bump_mn()
assert(mn == 3, "T1: expected 3, got " & mn)

# 2. -= on a numeric local, repeated.
print("--- 2. x -= 1 (x3) ---")
var x = 10
x -= 1
x -= 1
x -= 1
assert(x == 7, "T2: expected 7, got " & x)

# 3. *= on a numeric local, repeated.
print("--- 3. y *= 2 (x3) ---")
var y = 1
y *= 2
y *= 2
y *= 2
assert(y == 8, "T3: expected 8, got " & y)

# 4. /= on a numeric local, repeated. `/` always yields Float.
print("--- 4. z /= 2 (x2) ---")
var z = 100
z /= 2
z /= 2
assert(z == 25, "T4: expected 25, got " & z)

# 5. ^ has no compound form in the new language; explicit form.
print("--- 5. p = p ^ 2 ---")
var p = 3
p = p ^ 2
assert(p == 9, "T5: expected 9, got " & p)

# 6. mod has no compound form in the new language; explicit form.
print("--- 6. q = q mod 4 ---")
var q = 13
q = q mod 4
assert(q == 1, "T6: expected 1, got " & q)

# 7. &= on a string local, repeated.
print("--- 7. s &= ... (x2) ---")
var s = "a"
s &= "b"
s &= "c"
assert(s == "abc", "T7: expected abc, got " & s)

# 8. += inside a closure that captured an enclosing local (upvalue).
print("--- 8. closure upvalue += 1 (x3) ---")
local function make_counter()
    var count = 0
    var inc = function ()
        count += 1
    end
    inc()
    inc()
    inc()
    return count
end
assert(make_counter() == 3, "T8: expected 3")

# 9. Mixed read-after-write: confirm the post-state is observable.
print("--- 9. read-after-write ---")
var kk = 5
kk += 7
var after = kk
assert(after == 12, "T9: expected 12 after read, got " & after)

# 10. Instance fields: explicit form works (the compound form is a
#     compile error in the new engine — see the port note).
print("--- 10. instance field explicit form ---")
class Acc
    field n = 0
    field s = ""
end
var m = Acc()
m.n = m.n + 1
m.n = m.n + 1
m.n = m.n + 1
assert(m.n == 3, "T10a: expected 3, got " & m.n)
m.s = m.s & "ab"
m.s = m.s & "c"
assert(m.s == "abc", "T10b: expected abc, got " & m.s)

# 11. Table subscript.
print("--- 11. t['k'] += 1 (x3) ---")
var t = {"k": 0}
t["k"] += 1
t["k"] += 1
t["k"] += 1
assert(t["k"] == 3, "T11: expected 3, got " & t["k"])

# 12. List subscript.
print("--- 12. xs[1] += 1 (x3) ---")
var xs = [0, 100]
xs[1] += 1
xs[1] += 1
xs[1] += 1
assert(xs[1] == 3, "T12a: expected 3, got " & xs[1])
assert(xs[2] == 100, "T12b: neighbour untouched")

# 13. Local variable (the always-working case, guarded).
print("--- 13. local n += 1 (x3) ---")
var n = 0
n += 1
n += 1
n += 1
assert(n == 3, "T13: expected 3, got " & n)

print("")
print("==== ALL compound-assignment tests passed ====")
