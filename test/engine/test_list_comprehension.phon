# =====================================================================
# test_list_comprehension.phon
# =====================================================================
# PORT NOTE (old -> new engine): NOT YET IMPLEMENTED in the new engine.
#
# The old engine had list comprehensions:
#     [ <yield> foreach <var> [, <var>] in <coll> [if <cond> [else <e>]] ]
# The new engine does not implement a comprehension syntax yet (and has
# no `foreach` keyword); until it does, the working replacements are
# explicit `for ... in` loops over an accumulator, and library
# functions. This file pins those replacements for the comprehension
# shapes the old suite covered; when comprehensions land in the new
# engine, the originals can be restored on top of these semantics.
# Gap-logged in MIGRATION_NOTES.md.
# =====================================================================

print("==== comprehension replacements ====")

# Shape 1 (map): [n * 2 foreach n in nums]
print("--- 1. map over a list ---")
var nums1 = [1, 2, 3, 4]
var doubled1 = []
for n in nums1 do
    append(doubled1, n * 2)
end
assert(len(doubled1) == 4, "T1a: expected length 4, got " & len(doubled1))
assert(doubled1[1] == 2 and doubled1[4] == 8, "T1b: mapped values")

# The source list must not be mutated by the rewrite.
print("--- 2. source list not mutated ---")
var src2 = [10, 20, 30]
var copy2 = []
for n in src2 do
    append(copy2, n)
end
append(copy2, 999)
assert(len(src2) == 3, "T2: source mutated through aliasing")

print("--- 3. over an empty list ---")
var result3 = []
for n in [] do
    append(result3, n * 2)
end
assert(len(result3) == 0, "T3: expected empty result")

# Shape 2 (filter): [n foreach n in xs if n % 2 == 0]
print("--- 4. filter ---")
var evens4 = []
for n in [1, 2, 3, 4, 5, 6] do
    if n mod 2 == 0 then
        append(evens4, n)
    end
end
assert(len(evens4) == 3, "T4a: expected 3 evens")
assert(evens4[1] == 2 and evens4[3] == 6, "T4b: filtered values")

# Grapheme access replaces string iteration (see the header note).
print("--- 5. string graphemes via char() ---")
var upper5 = []
var word5 = "abc"
for i = 1 to len(word5) do
    append(upper5, to_upper(char(word5, i)))
end
assert(len(upper5) == 3, "T5a")
assert(upper5[1] == "A" and upper5[3] == "C", "T5b")

# Shape 3 (conditional): ["even" foreach n in xs if ... else "odd"]
# The new language keeps a conditional EXPRESSION: if ... then ... else ... end
print("--- 6. conditional mode preserves length ---")
var tags6 = []
for n in [1, 2, 3, 4, 5] do
    append(tags6, if n mod 2 == 0 then "even" else "odd" end)
end
assert(len(tags6) == 5, "T6a: expected length 5")
assert(tags6[1] == "odd" and tags6[2] == "even" and tags6[5] == "odd", "T6b")

# Two-variable form over a table: [k & "=" & v foreach k, v in t]
print("--- 7. pairs over a table ---")
var person7 = {"name": "John", "surname": "Smith"}
var pairs7 = []
for k, v in person7 do
    append(pairs7, k & "=" & v)
end
assert(len(pairs7) == 2, "T7a: expected 2 pairs")
# Order is hash-determined, so verify by membership.
assert(contains(pairs7, "name=John"), "T7b: missing name=John")
assert(contains(pairs7, "surname=Smith"), "T7c: missing surname=Smith")

# (index, value) form over a list.
print("--- 8. (i, value) form ---")
var labelled8 = []
for i, w in ["alpha", "beta", "gamma"] do
    append(labelled8, i & ":" & w)
end
assert(labelled8[1] == "1:alpha" and labelled8[3] == "3:gamma", "T8")

# Outer-variable access from the loop body.
print("--- 9. outer variable in the body ---")
var multiplier9 = 10
var result9 = []
for n in [1, 2, 3] do
    append(result9, n * multiplier9)
end
assert(result9[1] == 10 and result9[3] == 30, "T9")

# The loop variable does not leak / does not clobber an outer binding.
print("--- 10. loop var scoping ---")
var n10 = 999
var copy10 = []
for n10x in [1, 2, 3] do
    append(copy10, n10x)
end
assert(n10 == 999, "T10a: outer binding intact")
assert(copy10[2] == 2, "T10b")

# Nested accumulation ([[2*x foreach x in row] foreach row in rows]).
print("--- 11. nested ---")
var rows11 = [[1, 2], [3, 4], [5, 6]]
var sums11 = []
for row in rows11 do
    var inner = []
    for x in row do
        append(inner, 2 * x)
    end
    append(sums11, inner)
end
assert(len(sums11) == 3, "T11a")
assert(sums11[1][1] == 2 and sums11[3][2] == 12, "T11b")

# Filter runs before yield; rejected iterations skip the yield.
print("--- 12. filter-before-yield ordering ---")
var filter_calls12 = 0
var yield_calls12 = 0
local function pred12(n)
    filter_calls12 += 1
    return n > 2
end
local function transform12(n)
    yield_calls12 += 1
    return n
end
var result12 = []
for n in [1, 2, 3, 4] do
    if pred12(n) then
        append(result12, transform12(n))
    end
end
assert(filter_calls12 == 4, "T12a: pred should run 4x, got " & filter_calls12)
assert(yield_calls12 == 2, "T12b: transform should run 2x, got " & yield_calls12)
assert(len(result12) == 2, "T12c")

print("")
print("==== ALL comprehension-replacement tests passed ====")
