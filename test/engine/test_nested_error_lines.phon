# =====================================================================
# test_nested_error_lines.phon
# =====================================================================
# Regression test for error-line propagation across call boundaries.
#
# The property under test: an error raised inside a called function
# must report the actual throw site, not the outer call site, no
# matter how many frames it unwinds through.
#
# PORT NOTE (old -> new engine): `get_error_line()` / `get_error_trace()`
# do not exist. An Error instance carries `e.trace`, a String captured
# once at first raise, one frame per line, innermost-first:
#     at <function> (line N)
# so these tests parse the FIRST trace line instead of calling
# get_error_line(). Two old cases changed materially:
#   - float `1 / 0` no longer raises (it yields inf); the native math
#     error is pinned with integer `1 div 0` instead;
#   - the undefined-variable case is gone: an unresolved name is now a
#     COMPILE error (assignment/reads never resolve dynamically).
# Both are gap-logged in MIGRATION_NOTES.md.
#
# IMPORTANT: this test asserts specific physical line numbers. The
# throw/error sites are concentrated in the helper block below; each
# LINE_* constant must be kept in sync with the actual line numbers.
# =====================================================================

# --- Helpers --------------------------------------------------------
# All throw/error sites live here. The LINE_* constants are declared
# together after the helpers; keep them in sync when editing.

local function throw_inner()
    throw Error("inner boom")
end

local function call_inner()
    throw_inner()
end

local function call_call_inner()
    call_inner()
end

local function divide_zero()
    var x = 1 div 0
end

local function out_of_bounds()
    var xs = [1, 2, 3]
    var bad = xs[100]
end

var LINE_INNER = 32
var LINE_OUTER_CALL = 36
var LINE_DIVIDE = 44
var LINE_OOB = 49

# The first line of an error's trace is its innermost frame.
# (rtrim: e.trace ends with a newline, and the engine's split currently
# aborts on a trailing separator — gap-logged in MIGRATION_NOTES.md.)
local function innermost(e)
    var tr = e.trace
    rtrim(tr)
    var entries = split(tr, "\n")
    return entries[1]
end

# --- Tests ----------------------------------------------------------

# 1. Script-level throw caught in the same frame: the innermost trace
#    frame is this module's top level.
print("--- 1. same-frame throw ---")
try
    throw Error("direct")
catch e
    assert(contains(innermost(e), "<module>"), "same-frame trace must point at the module top level, got: " & innermost(e))
end

# 2. Throw from one frame deeper. THIS IS THE CORE PROPERTY: the trace
#    must report the throw site inside throw_inner(), not the call site
#    in this frame.
print("--- 2. one-deep call (script throw) ---")
try
    call_inner()
catch e
    assert(contains(innermost(e), "throw_inner (line " & LINE_INNER & ")"), "expected inner throw line " & LINE_INNER & ", got: " & innermost(e))
end

# 3. Throw from two frames deeper. Same property, harder to mask: the
#    line must survive two unwinds.
print("--- 3. two-deep call (script throw) ---")
try
    call_call_inner()
catch e
    assert(contains(innermost(e), "throw_inner (line " & LINE_INNER & ")"), "expected inner throw line " & LINE_INNER & " through two frames, got: " & innermost(e))
end

# 4. Native math error from inside a callee (integer division by zero;
#    float 1/0 yields inf in the new engine and raises nothing).
print("--- 4. divide by zero in callee ---")
try
    divide_zero()
catch e
    assert(contains(innermost(e), "divide_zero (line " & LINE_DIVIDE & ")"), "expected divide-by-zero line " & LINE_DIVIDE & ", got: " & innermost(e))
end

# 5. Native out-of-bounds error from inside a callee.
print("--- 5. out-of-bounds in callee ---")
try
    out_of_bounds()
catch e
    assert(contains(innermost(e), "out_of_bounds (line " & LINE_OOB & ")"), "expected out-of-bounds line " & LINE_OOB & ", got: " & innermost(e))
end

# 6. Structural cross-check: regardless of any line-counting drift in
#    this file, the innermost line must NOT be the outer call site.
#    This is the property that genuinely encodes the bug class: if the
#    regression came back, the trace head would name the call site.
print("--- 6. inner != outer call site (structural) ---")
try
    call_inner()
catch e
    assert(not contains(innermost(e), "(line " & LINE_OUTER_CALL & ")"), "regression: trace head reports the outer call site (" & LINE_OUTER_CALL & ")")
end

# 7. Re-raising preserves the ORIGINAL trace (captured once at first
#    raise): `throw e` must not re-stamp the trace at the rethrow site.
print("--- 7. rethrow preserves the original throw site ---")
try
    try
        call_inner()
    catch e
        throw e
    end
catch e2
    assert(contains(innermost(e2), "throw_inner (line " & LINE_INNER & ")"), "rethrow must keep the original innermost frame, got: " & innermost(e2))
end

print("test_nested_error_lines: OK")
