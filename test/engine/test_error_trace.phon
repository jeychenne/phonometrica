# =====================================================================
# test_error_trace.phon
# =====================================================================
# Verifies the call-stack trace attached to an error at its FIRST
# raise. In the new engine the trace lives on the Error value itself
# (`e.trace`, a String), captured once by the raise and preserved
# across re-throws; there is no separate get_error_trace() builtin.
#
# Trace shape (innermost-first, one frame per line):
#     at <function> (line N)
#     at <function> (line N)
#     ...
#     at <module> (line N)          # top-level frame
#
# PORT NOTE (old -> new engine): the old API returned a List of
# {file, line, function} Tables; the new trace is a rendered String,
# so these tests parse lines out of it. There is no `file` component
# (gap-logged). Line numbers are asserted via LINE_* constants that
# must match the physical lines of the helpers below; the trace is
# captured at first raise, so the "replacement across catches" test
# becomes "each new Error gets its own fresh trace".
# =====================================================================

# --- Helpers --------------------------------------------------------

local function throw_inner()
    throw Error("deep")
end

local function call_inner()
    throw_inner()
end

local function call_call_inner()
    call_inner()
end

local function divide_zero()
    var x = 1 div 0
end

var LINE_THROW = 27
var LINE_CALL_INNER_CALL = 31
var LINE_CALL_CALL_INNER_CALL = 35
var LINE_DIVIDE = 39

# Split a trace into its lines. (rtrim first: the trace ends with a
# newline and the engine's split currently aborts on a trailing
# separator — gap-logged in MIGRATION_NOTES.md.)
local function trace_entries(e)
    var tr = e.trace
    rtrim(tr)
    return split(tr, "\n")
end

# --- Tests ----------------------------------------------------------

# 1. Same-frame catch of a script throw: trace has one entry, the
#    module-level throw site.
print("--- 1. same-frame throw ---")
try
    throw Error("same-frame")
catch e
    var tr = trace_entries(e)
    assert(len(tr) == 1, "same-frame: expected 1 entry, got " & len(tr))
    assert(contains(tr[1], "<module>"), "same-frame: expected frame <module>, got " & tr[1])
end

# 2. One-deep script throw. The throw is in throw_inner; the call site
#    is inside call_inner; the catch sits at the module level. So the
#    trace is three frames deep: [throw_inner, call_inner, <module>].
#    CALL_SITE_2 must match the physical line of the `call_inner()`
#    call below.
print("--- 2. one-deep script throw ---")
var CALL_SITE_2 = 77
try
    call_inner()
catch e
    var tr = trace_entries(e)
    assert(len(tr) == 3, "one-deep: expected 3 entries, got " & len(tr))

    # Innermost: the throw site inside throw_inner.
    assert(contains(tr[1], "throw_inner (line " & LINE_THROW & ")"), "one-deep tr[1]: expected throw_inner line " & LINE_THROW & ", got " & tr[1])

    # Middle: the call site to throw_inner inside call_inner.
    assert(contains(tr[2], "call_inner (line " & LINE_CALL_INNER_CALL & ")"), "one-deep tr[2]: expected call_inner line " & LINE_CALL_INNER_CALL & ", got " & tr[2])

    # Outermost: the call site to call_inner at the module level.
    assert(contains(tr[3], "<module> (line " & CALL_SITE_2 & ")"), "one-deep tr[3]: expected <module> line " & CALL_SITE_2 & ", got " & tr[3])
end

# 3. Two-deep script throw — trace must have four entries.
#    CALL_SITE_3 must match the physical line of the
#    `call_call_inner()` call below.
print("--- 3. two-deep script throw ---")
var CALL_SITE_3 = 98
try
    call_call_inner()
catch e
    var tr = trace_entries(e)
    assert(len(tr) == 4, "two-deep: expected 4 entries, got " & len(tr))
    assert(contains(tr[1], "throw_inner (line " & LINE_THROW & ")"), "two-deep tr[1]")
    assert(contains(tr[2], "call_inner (line " & LINE_CALL_INNER_CALL & ")"), "two-deep tr[2]")
    assert(contains(tr[3], "call_call_inner (line " & LINE_CALL_CALL_INNER_CALL & ")"), "two-deep tr[3]")
    assert(contains(tr[4], "<module> (line " & CALL_SITE_3 & ")"), "two-deep tr[4]")
end

# 4. Native error (integer division by zero) deep in a callee: the
#    trace must still report the throwing function. (Float 1/0 yields
#    inf in the new engine, so the native error is `div`.)
#    CALL_SITE_4 must match the physical line of the `divide_zero()`
#    call below.
print("--- 4. native error one-deep ---")
var CALL_SITE_4 = 116
try
    divide_zero()
catch e
    var tr = trace_entries(e)
    assert(len(tr) == 2, "native one-deep: expected 2 entries, got " & len(tr))
    assert(contains(tr[1], "divide_zero (line " & LINE_DIVIDE & ")"), "native tr[1]: expected divide_zero line " & LINE_DIVIDE & ", got " & tr[1])
    assert(contains(tr[2], "<module> (line " & CALL_SITE_4 & ")"), "native tr[2]: expected <module> line " & CALL_SITE_4 & ", got " & tr[2])
end

# 5. Each caught error carries its own fresh trace (the trace is a
#    field of the Error value, not runtime-global state).
print("--- 5. traces are per-error ---")
var first_trace = ""
try
    throw Error("first")
catch e
    first_trace = e.trace
    assert(len(trace_entries(e)) == 1, "first catch: expected 1 entry")
end
try
    call_inner()
catch e
    var tr = trace_entries(e)
    assert(len(tr) == 3, "second catch (after first): expected 3 entries, got " & len(tr))
    assert(contains(tr[1], "throw_inner"), "second catch: tr[1] must be inner")
    assert(e.trace != first_trace, "the two errors must not share a trace")
end

print("test_error_trace: OK")
