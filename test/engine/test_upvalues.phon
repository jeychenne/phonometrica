# =====================================================================
# test_upvalues.phon
# =====================================================================
# Regression test for captured-variable mutation across `local function`
# definitions. A function that closes over a String/List defined in the
# enclosing scope must see and propagate mutations performed via
# mutating natives like `append` (which take their target by `ref` in
# the new engine and write back through the reference box).
#
# PORT NOTE (old -> new engine): `let` -> `var`; assert/print are calls.
# At the top level the captured names are module bindings (reached via
# module slots); the genuinely closure-captured (upvalue) case is
# additionally pinned inside a function at the end. Both routes must
# behave identically. See MIGRATION_NOTES.md.
# =====================================================================

print("==== captured-variable mutation x mutating natives ====")

# 1. Local function appending to an enclosing String through `append`.
#    append(String&) promotes its target to a reference and writes the
#    mutated value back — both scopes must see the updated value.
print("--- 1. append into enclosing String ---")
var s1 = "hello"
local function test_string_append()
    # Two locals, then a mutation of the enclosing binding. Locals must
    # not interfere with the outward name resolution.
    var s2 = "blabla"
    var s3 = " world"
    append(s1, s3)
end
assert(s1 == "hello", "before call: expected 'hello', got " & s1)
test_string_append()
assert(s1 == "hello world", "after call: expected 'hello world', got " & s1)

# 2. Repeated mutation. Each call must see the previous one.
print("--- 2. repeated append ---")
var s4 = "x"
local function add_y()
    append(s4, "y")
end
add_y()
add_y()
add_y()
assert(s4 == "xyyy", "after 3 calls: expected 'xyyy', got " & s4)

# 3. Same mechanism on a List with `append`.
print("--- 3. append into enclosing List ---")
var xs = [1, 2]
local function push_three()
    append(xs, 3)
end
push_three()
assert(len(xs) == 3, "List length: expected 3, got " & len(xs))
assert(xs[3] == 3, "List element: expected 3, got " & xs[3])

# 4. Two functions sharing the same enclosing binding.
print("--- 4. shared binding ---")
var counter = 0
local function inc()
    counter += 1
end
local function read_counter()
    return counter
end
inc()
inc()
inc()
assert(read_counter() == 3, "shared counter: expected 3, got " & read_counter())

# 5. True upvalues: closures over a function local (not a module
#    binding), sharing one box.
print("--- 5. true upvalue capture ---")
local function make_pair()
    var total = 0
    var slog = ""
    var add = function (k)
        total += k
        append(slog, "+")
    end
    add(2)
    add(3)
    return [total, slog]
end
var got = make_pair()
assert(got[1] == 5, "upvalue total: expected 5, got " & got[1])
assert(got[2] == "++", "upvalue string: expected '++', got " & got[2])

print("")
print("==== ALL upvalue tests passed ====")
