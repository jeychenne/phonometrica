# =====================================================================
# test_gui_trace.phon — manual smoke test for the GUI trace rendering.
# =====================================================================
# NOT part of run_all.phon: this script deliberately ends with an
# UNCAUGHT error so the surrounding application (script editor /
# console) can demonstrate its trace rendering. Run it by hand.
#
# PORT NOTE (old -> new engine): `get_error_line()`/`get_error_trace()`
# do not exist; a caught error carries `e.message` and `e.trace` (a
# rendered String, innermost-first, one `at <fn> (line N)` per frame,
# with no file component — gap-logged). The old `bad_math()` used float
# 1/0, which no longer raises (it yields inf): it now uses `1 div 0`.
# The old `bad_var()` (undefined variable at runtime) is gone — an
# unresolved name is a COMPILE error in the new engine.
#
# What to expect when run under the future GUI runtime:
# 1. The caught-error section prints each error's message and trace.
# 2. The final uncaught error should be rendered by the host with its
#    trace, and the editor should highlight the deepest in-file frame
#    (the `throw Error(...)` line inside deep_throw).
# =====================================================================


# --- Helper functions ----------------------------------------------

local function deep_throw()
    throw Error("from the bottom")
end

local function middle()
    deep_throw()
end

local function outer()
    middle()
end

local function bad_math()
    var x = 1 div 0
end

local function bad_index()
    var xs = [1, 2, 3]
    var v = xs[100]
end

local function same_frame_throw()
    throw Error("top-level throw")
end


# --- Helper to dump a caught error ---------------------------------

local function dump_trace(label, e)
    print("--- " & label & " ---")
    print("  message: " & e.message)
    print("  trace:")
    print(e.trace)
    print("")
end


# --- Section 1: API verification (caught errors) -------------------

print("================================================================")
print("Caught-error traces (Error.trace field)")
print("================================================================")

try
    outer()
catch e
    dump_trace("3-deep script throw via outer()", e)
end

try
    bad_math()
catch e
    dump_trace("integer divide-by-zero via bad_math()", e)
end

try
    bad_index()
catch e
    dump_trace("native out-of-bounds via bad_index()", e)
end


# --- Section 2: uncaught error (host renders the trace) ------------

print("================================================================")
print("About to raise an uncaught error; the host should render its")
print("trace and highlight the deepest in-file line.")
print("================================================================")

# Uncomment exactly ONE of the following lines.

outer()
# bad_math()
# bad_index()
# same_frame_throw()
