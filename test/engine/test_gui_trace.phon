# =====================================================================
# test_gui_trace.phon — manual smoke test for the GUI trace rendering.
# =====================================================================
# Open this in the script editor and hit Run. You should see:
#
# 1.  In the OUTPUT panel (above the console):
#     A walk through three caught errors. For each, the script prints
#     `get_error_line()` and iterates `get_error_trace()`, listing the
#     frames innermost-first. Confirms the script-level API works inside
#     the GUI runtime, independent of the visual trace rendering.
#
# 2.  In the CONSOLE (below the output panel):
#     One uncaught error rendered as:
#         Error at line <N>
#         <error message>
#           at <file>:<line> in <function>     <-- muted red, indented
#           at <file>:<line> in <function>
#           ...
#     Trace lines are innermost-first; the throw site is the topmost
#     trace row, the catching frame (here the implicit `<chunk>`) is
#     the bottom row.
#
# 3.  In the EDITOR (this buffer):
#     The line corresponding to the deepest IN-THIS-FILE frame of the
#     uncaught error is underlined and scrolled into view. With the
#     default `outer()` selection below, that should land on the
#     `throw "from the bottom"` line inside `deep_throw` (the
#     innermost frame is also in this file, so the deepest in-file
#     frame == innermost frame).
#
# To exercise different error paths, comment out the active call at
# the bottom and uncomment one of the alternatives. Each demonstrates
# a different runtime throw site:
#
#     outer()         - 3-deep script throw
#     bad_math()      - native float divide-by-zero in a callee
#     bad_index()     - native out-of-bounds index in a callee
#     bad_var()       - undefined variable in a callee
#     same_frame_throw() - 1-frame trace, throw at top level
# =====================================================================


# --- Helper functions ----------------------------------------------

function deep_throw()
    throw "from the bottom"
end

function middle()
    deep_throw()
end

function outer()
    middle()
end

function bad_math()
    let x = 1 / 0
end

function bad_index()
    let xs = [1, 2, 3]
    let v = xs[100]
end

function bad_var()
    return some_undefined_name
end

function same_frame_throw()
    throw "top-level throw"
end


# --- Helper to dump a trace to the output panel --------------------

function dump_trace(label)
    print "--- " & label & " ---"
    print "  line: " & str(get_error_line())
    let tr = get_error_trace()
    print "  depth: " & str(len(tr))
    foreach entry in tr do
        let f = entry["function"]
        let l = entry["line"]
        let p = entry["file"]
        print "    at " & str(p) & ":" & str(l) & " in " & str(f)
    end
    print ""
end


# --- Section 1: API verification (caught errors → output panel) ---

print "================================================================"
print "Caught-error traces (script-level get_error_trace API)"
print "================================================================"

try
    outer()
catch
    dump_trace("3-deep script throw via outer()")
end

try
    bad_math()
catch
    dump_trace("native float divide-by-zero via bad_math()")
end

try
    bad_index()
catch
    dump_trace("native out-of-bounds via bad_index()")
end


# --- Section 2: uncaught error (GUI renders the trace in red) -----

print "================================================================"
print "About to raise an uncaught error; trace should appear in the"
print "console (red) and the deepest in-file line should be highlighted."
print "================================================================"

# Uncomment exactly ONE of the following lines.

outer()
# bad_math()
# bad_index()
# bad_var()
# same_frame_throw()
