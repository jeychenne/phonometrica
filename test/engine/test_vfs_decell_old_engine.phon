# =====================================================================
# test_vfs_decell.phon (old scripting language)
# =====================================================================
# Runtime smoke for step 5 (VFS de-celling): exercises the poly-boxed
# Element hierarchy through the OLD engine — construction, field
# dispatch, natives with base-typed (Document/DataTable) parameters
# receiving subclass instances, script-level dynamic-class checks on the class
# graph (via type()), and shared identity through multiple handles.
# Must produce identical output before and after the de-celling.
# =====================================================================

print "==== vfs de-celling: annotation (in-memory) ===="

let a = new_annotation()
assert type(a) == Annotation, "A1: dynamic class is Annotation"
assert type(a) != Sound, "A2: dynamic class is not Sound"
assert a.nlayer == 0, "A5: nlayer field == 0"

create_layer(a, 1, "words", false)
assert a.nlayer == 1, "A6: nlayer field == 1"
assert get_layer_label(a, 1) == "words", "A7: layer label"
add_interval(a, 1, 0.0, 1.0, "hello")
add_interval(a, 1, 1.0, 2.0, "world")
assert get_event_count(a, 1) == 2, "A8: event count"
assert get_event_text(a, 1, 2) == "world", "A9: event text"
set_event_text(a, 1, 2, "there")
assert get_event_text(a, 1, 2) == "there", "A10: set event text"

# Shared identity: a second handle sees mutations made through the first.
let a2 = a
set_event_text(a2, 1, 1, "goodbye")
assert get_event_text(a, 1, 1) == "goodbye", "A11: shared identity"

print "==== vfs de-celling: document-typed natives on subclasses ===="

# add_property/get_property are registered on Document: an Annotation
# argument exercises subclass-into-base dispatch.
add_property(a, "speaker", "jm")
assert get_property(a, "speaker") == "jm", "P1: property round-trip"
add_property(a, "weight", 1.5)
assert get_property(a, "weight") == 1.5, "P2: numeric property"
remove_property(a, "speaker")
assert get_property(a, "speaker") == null, "P3: removed property is null"

# Document field dispatcher on an Annotation (path/label).
assert a.path == "", "P4: empty path field"

print "==== vfs de-celling: dataset via polymorphic load() ===="

# Run from the repository root (paths are relative to the working directory).
let d = load("test/data/inst_eval.csv")
assert type(d) == Dataset, "D1: dynamic class is Dataset"
assert type(d) != Annotation, "D2: dynamic class is not Annotation"
assert d.nrow > 0, "D5: nrow field"
assert d.ncol > 0, "D6: ncol field"

# DataTable-typed natives receiving a Dataset.
let h = get_header(d, 1)
assert len(h) > 0, "D7: get_header"
let old_cell = get_cell(d, 1, 1)
set_cell(d, 1, 1, "42")
assert get_cell(d, 1, 1) == "42", "D8: set_cell/get_cell"
let d2 = d
assert get_cell(d2, 1, 1) == "42", "D9: shared identity through second handle"
set_cell(d, 1, 1, old_cell)

# load() returns the SAME object when the file is already in the project.
let d3 = load("test/data/inst_eval.csv")
set_cell(d3, 2, 1, "99")
assert get_cell(d, 2, 1) == "99", "D10: load() returns shared instance"

print "==== vfs de-celling: project lists ===="

let annots = get_annotations()
let sounds = get_sounds()
let datasets = get_datasets()
assert len(sounds) == 0, "L1: no sounds"
assert len(datasets) == 1, "L2: one dataset"
assert type(datasets[1]) == Dataset, "L3: list element dynamic class"

print "test_vfs_decell.phon passed"
