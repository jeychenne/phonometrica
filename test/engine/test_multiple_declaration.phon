# =====================================================================
# test_multiple_declaration.phon
# =====================================================================
# PORT NOTE (old -> new engine): THIS FEATURE WAS REMOVED.
#
# The old engine supported multi-LHS declarations and assignments:
#     let x, y            let x, y = 1, 2         let x, y = lst
#     x, y = b, a         a, b, c = lst
# The new language deliberately has neither multiple declaration nor
# multiple assignment (DEVIATIONS.md, M3 AST #4): `var`/`const` and
# assignment are single-target; the only multi-binding construct is
# `for k, v in ...`. Implicit globals (assignment declaring a new name)
# are also gone: assignment never declares (design §11), so a typo'd
# target is now a COMPILE error.
#
# This file keeps the old path and pins the new-language equivalents of
# the patterns the old suite covered, so the cutover suite still
# exercises the surface scripts will actually use. The removal itself
# is gap-logged in MIGRATION_NOTES.md.
# =====================================================================

print("==== multiple declaration (removed) -> single-target equivalents ====")

# Old shape 1: `let x, y = 1, 2`  ->  two declarations.
print("--- 1. parallel declaration -> two vars ---")
var x1 = 1
var y1 = 2
assert(x1 == 1, "T1a")
assert(y1 == 2, "T1b")

# Old shape 2: `let x, y = lst`  ->  explicit element reads.
print("--- 2. destructure -> explicit indexing ---")
var pair = [3, 10]
var lo = pair[1]
var hi = pair[2]
assert(lo == 3, "T2a")
assert(hi == 10, "T2b")
# Source list is untouched, and a mutated copy detaches (CoW).
var inner = pair
append(inner, 99)
assert(len(pair) == 2, "T2c: source list must stay length 2 (CoW)")

# Old shape 3: swap `a, b = b, a`  ->  explicit temporary.
print("--- 3. swap -> explicit temporary ---")
var a = 1
var b = 2
var tmp = a
a = b
b = tmp
assert(a == 2 and b == 1, "T3: swap via temporary")

# The one surviving multi-binding construct: `for k, v in ...`.
print("--- 4. for k, v in list (the remaining multi-binding form) ---")
var ks = []
var vs = []
for k, v in ["a", "b", "c"] do
    append(ks, k)
    append(vs, v)
end
assert(ks[1] == 1 and ks[2] == 2 and ks[3] == 3, "T4a: 1-based keys")
assert(vs[1] == "a" and vs[3] == "c", "T4b: values in order")

# Function returning several values: return a List, read elements.
print("--- 5. multi-value return -> List return ---")
local function make_pair()
    return [10, 20]
end
var mp = make_pair()
assert(mp[1] == 10 and mp[2] == 20, "T5: list-returning function")

print("")
print("==== multiple-declaration equivalents passed ====")
