# =====================================================================
# test_string_interpolation.phon
# =====================================================================
# Smoke test for string interpolation in the scripting engine.
# Each block prints a banner so any failure is localized; assert halts
# the script at the first regression.
#
# PORT NOTE (old -> new engine): the interpolation marker changed from
# ${expr} to {expr} (design.md §12). A literal brace in a double-quoted
# string is written \{ (unknown escapes are now hard errors). The two
# string families also changed semantics: "..." (and """...""")
# interpolates and processes escapes; '...' (and '''...''') is RAW —
# single-quoted strings NO LONGER interpolate, reversing the old
# behaviour pinned by the original test 9. See MIGRATION_NOTES.md.
# =====================================================================

# 1. Basic single-variable interpolation.
print("--- 1. single variable ---")
var name = "world"
assert("hello {name}" == "hello world", "single var")

# 2. Multiple interpolation segments in the same literal.
print("--- 2. multiple segments ---")
var f1 = 500
var f2 = 1500
assert("F1={f1} F2={f2}" == "F1=500 F2=1500", "two segments")
assert("{f1}-{f2}-{f1}" == "500-1500-500", "three segments back-to-back")

# 3. Numeric coercion goes through the same path that '&' uses.
print("--- 3. numeric coercion ---")
var n = 42
assert("n={n}" == "n=42", "int coercion")
var x = 3.5
assert("x={x}" == "x=3.5", "float coercion")

# 4. Empty leading and trailing literal chunks.
print("--- 4. empty chunks ---")
var v = "X"
assert("{v}" == "X", "no surrounding literal")
assert("{v}foo" == "Xfoo", "empty leading chunk")
assert("foo{v}" == "fooX", "empty trailing chunk")

# 5. Arbitrary expressions inside {...}.
print("--- 5. expressions ---")
var a = 3
var b = 4
assert("sum={a + b}" == "sum=7", "arithmetic")
assert("prod={a * b}" == "prod=12", "multiplication")

# 6. Function calls inside {...}.
print("--- 6. function call ---")
local function twice(z)
    return z * 2
end
assert("d={twice(7)}" == "d=14", "function call")
assert("{twice(twice(3))}" == "12", "nested function calls")

# 7. \{ escape suppresses interpolation; the result is a literal '{'.
print("--- 7. brace escape ---")
var m = "ZZZ"
assert(len("price: \{m}") == 10, "escaped brace produces literal text")
assert("\{" & "}" == "\{}", "escaped brace pair")
assert("\{ then {m}" == "\{ then ZZZ", "escaped then real")

# 8. Single-quoted strings are RAW: no interpolation, no escapes.
#    (Old engine interpolated single-quoted strings; the new language
#    reserves them for regexes and Windows paths.)
print("--- 8. single quotes are raw ---")
var q = "hi"
assert('{q} there' == "\{q} there", "single-quoted string does not interpolate")
assert(len('\n') == 2, "single-quoted string does not process escapes")

# 9. Triple-quoted double-quote strings interpolate; triple single-quote
#    strings are raw.
print("--- 9. triple-quoted ---")
var who = "Lea"
assert("""welcome {who}""" == "welcome Lea", "triple double-quote interpolates")
assert('''welcome {who}''' == "welcome \{who}", "triple single-quote is raw")

# 10. Nested interpolation: an inner {...} inside the embedded
# expression of an outer {...}, including a nested string literal.
print("--- 10. nested ---")
var mid = "X"
assert("a{"b{mid}c"}d" == "abXcd", "two-level nesting")

# 11. Interpolation embedded in a larger expression.
print("--- 11. inside larger expression ---")
var k = 2
var result = "n=" & "{k}" & "!"
assert(result == "n=2!", "interp as concat operand")
var s = "[{k}]"
assert(s & " trailing" == "[2] trailing", "interp followed by concat")

# 12. Table subscripts (and their quotes) inside {...} are tracked by the
# scanner's per-interpolation depth, so the embedded expression can
# contain its own brackets and string literals.
print("--- 12. subscript inside interpolation ---")
var t = {"name": "Lobanov"}
assert("method={t["name"]}" == "method=Lobanov", "table subscript inside")

# 13. Whitespace inside {...} is tolerated; the embedded expression
# is parsed exactly like an ordinary expression.
print("--- 13. internal whitespace ---")
var w = 9
assert("v={ w }" == "v=9", "spaces around expression")
assert("v={  w  }" == "v=9", "multiple spaces")

print("")
print("All string-interpolation tests passed.")
