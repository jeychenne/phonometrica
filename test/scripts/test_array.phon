# Numeric Array literals (design §9): `@[...]`. 1-D with `,`; 2-D with `;` separating
# rows. Integers are promoted to Float (the buffer is double). Elements print in
# natural (row-major) reading order.

# 1-D literal and printing.
var v = @[1, 2, 3, 4]
assert(to_string(v) == "[1, 2, 3, 4]", "1-D array prints in order: " & to_string(v))

# Integer elements are promoted to Float, so a fractional value coexists.
var mixed = @[1, 2.5, 3]
assert(to_string(mixed) == "[1, 2.5, 3]", "int elements promote to float: " & to_string(mixed))

# 2-D literal: rows separated by `;`, printed row-major with `;` between rows.
var m = @[1, 2, 3; 4, 5, 6]
assert(to_string(m) == "[1, 2, 3; 4, 5, 6]", "2-D array prints row-major: " & to_string(m))

# A column vector (each row one element).
var col = @[1; 2; 3]
assert(to_string(col) == "[1; 2; 3]", "column vector: " & to_string(col))

# Elements may be arbitrary numeric expressions.
var x = 10
var computed = @[x, x + 1, x * 2]
assert(to_string(computed) == "[10, 11, 20]", "computed elements: " & to_string(computed))

# An Array is-a Object but distinct from a List.
assert(@[1, 2] is Object, "array is an Object")
assert(not (@[1, 2] is List), "array is not a List")

# Structural equality (shape + elements).
assert(@[1, 2, 3] == @[1, 2, 3], "equal arrays")
assert(not (@[1, 2, 3] == @[1, 2, 4]), "unequal elements")
assert(not (@[1, 2, 3] == @[1, 2]), "unequal shape")

# --- indexing (1-based, negatives from the end) ---
var a = @[10, 20, 30, 40]
assert(a[1] == 10, "first element")
assert(a[4] == 40, "last element")
assert(a[-1] == 40, "negative index")
assert(a[-4] == 10, "negative index to first")

# A scalar element is a Float (the buffer is double).
assert(a[1] is Float, "array element is a Float")

# Element assignment (copy-on-write under the hood).
var b = @[1, 2, 3]
b[2] = 20
assert(b == @[1, 20, 3], "element assignment")
b[-1] = 30
assert(b == @[1, 20, 30], "negative-index assignment")

# Compound assignment on a 1-D element.
b[1] += 100
assert(b[1] == 101, "compound element assignment")

# Multi-dimensional indexing: m[row, col], 1-based.
var m = @[1, 2, 3; 4, 5, 6]
assert(m[1, 1] == 1, "m[1,1]")
assert(m[2, 3] == 6, "m[2,3]")
assert(m[1, 3] == 3, "m[1,3]")
assert(m[-1, -1] == 6, "m[-1,-1]")

m[1, 2] = 99
assert(m[1, 2] == 99, "2-D element assignment")
assert(m == @[1, 99, 3; 4, 5, 6], "2-D assignment result")

# CoW: mutating a copy leaves the original untouched.
var orig = @[1, 2, 3]
var copy = orig
copy[1] = 99
assert(orig[1] == 1, "CoW: original untouched")
assert(copy[1] == 99, "CoW: copy mutated")

# Errors: out of range, wrong index count, and no references to elements.
var oor = false
try
    var x = a[99]
catch e as Error
    oor = true
end
assert(oor, "out-of-range index raises")

var wrongrank = false
try
    var x = m[1]
catch e as Error
    wrongrank = true
end
assert(wrongrank, "wrong index count raises")

# `len` reports the element count.
assert(len(@[10, 20, 30]) == 3, "len of a 1-D array")
assert(len(@[1, 2, 3; 4, 5, 6]) == 6, "len of a 2-D array")

# A numeric element cannot be taken by reference (a double is not boxable).
function bump(ref x as Object)
    x = 0
end
var noref = false
try
    var arr = @[1, 2, 3]
    bump(arr[1])
catch e as Error
    noref = true
end
assert(noref, "cannot take a reference to an Array element")

# --- slicing (zero-copy views) ---
var w = @[10, 20, 30, 40, 50]
assert(w[2:4] == @[20, 30, 40], "1-D slice")
assert(w[:] == w, "full slice")
assert(w[3:] == @[30, 40, 50], "open stop")
assert(w[:2] == @[10, 20], "open start")
assert(w[-2:-1] == @[40, 50], "negative bounds")
assert(w[1:5 step 2] == @[10, 30, 50], "strided slice")
assert(w[5:1 step -1] == @[50, 40, 30, 20, 10], "reversed slice")

# A slice shares the buffer, but slicing does not mutate the source.
assert(w == @[10, 20, 30, 40, 50], "source unchanged after slicing")

# 1-D slice assignment: same-length array or scalar broadcast.
var z = @[1, 2, 3, 4, 5]
z[2:4] = @[20, 30, 40]
assert(z == @[1, 20, 30, 40, 5], "slice assign from an array")
z[1:5 step 2] = 0
assert(z == @[0, 20, 0, 40, 0], "strided broadcast assign")

# Multi-dimensional slicing: rows, columns, sub-blocks.
var m = @[1, 2, 3; 4, 5, 6]
assert(m[1, :] == @[1, 2, 3], "row as a 1-D view")
assert(m[:, 2] == @[2, 5], "column as a 1-D view (axis collapse)")
assert(m[2, :] == @[4, 5, 6], "second row")
assert(m[:, 1] == @[1, 4], "first column")
assert(m[1:2, 2:3] == @[2, 3; 5, 6], "2x2 sub-block")

# A column view shares the buffer; the source is unchanged by reading it.
assert(m == @[1, 2, 3; 4, 5, 6], "matrix unchanged after slicing")

# CoW through a shared buffer: mutating a slice-view detaches it (the view and the
# source share the buffer), so the source stays intact.
var src = @[1, 2, 3, 4]
var sl = src[2:3]
sl[1] = 99
assert(src == @[1, 2, 3, 4], "mutating a slice-view leaves the source intact")
assert(sl == @[99, 3], "the slice-view was mutated")

# --- elementwise arithmetic ---
var p = @[1, 2, 3]
var q = @[10, 20, 30]
assert(p + q == @[11, 22, 33], "elementwise add")
assert(q - p == @[9, 18, 27], "elementwise sub")
assert(p * q == @[10, 40, 90], "elementwise mul")
assert(q / p == @[10, 10, 10], "elementwise div")
assert(@[2, 3] ^ @[3, 2] == @[8, 9], "elementwise pow")

# Scalar broadcast (either side).
assert(p * 2 == @[2, 4, 6], "array * scalar")
assert(2 * p == @[2, 4, 6], "scalar * array")
assert(p + 10 == @[11, 12, 13], "array + scalar")
assert(10 - p == @[9, 8, 7], "scalar - array")

# 2-D elementwise.
var m1 = @[1, 2; 3, 4]
var m2 = @[10, 20; 30, 40]
assert(m1 + m2 == @[11, 22; 33, 44], "2-D elementwise add")

# Arithmetic on a strided view (a column), gathered before the kernel.
var big = @[1, 2, 3; 4, 5, 6]
assert(big[:, 2] + big[:, 3] == @[5, 11], "add of two column views")

# Shape mismatch is an error.
var badshape = false
try
    var r = @[1, 2, 3] + @[1, 2]
catch e as Error
    badshape = true
end
assert(badshape, "shape mismatch raises")

print("array tests passed")
