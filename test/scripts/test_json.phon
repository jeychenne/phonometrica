# Standard library: the JSON module (architecture §12). Exercises to_json (compact and
# pretty) and from_json, plus the round-trip between them. JSON object <-> Table, array
# <-> List, number -> Integer/Float, and string escaping/unescaping.

# --- to_json: scalars -------------------------------------------------------------
assert(to_json(null) == "null", "to_json null")
assert(to_json(true) == "true", "to_json true")
assert(to_json(false) == "false", "to_json false")
assert(to_json(42) == "42", "to_json Integer")
assert(to_json(-7) == "-7", "to_json negative Integer")
assert(to_json("hello") == "\"hello\"", "to_json String")
assert(to_json("") == "\"\"", "to_json empty String")

# --- to_json: string escaping -----------------------------------------------------
assert(to_json("a\"b") == "\"a\\\"b\"", "to_json escapes quote")
assert(to_json("a\\b") == "\"a\\\\b\"", "to_json escapes backslash")
assert(to_json("line1\nline2") == "\"line1\\nline2\"", "to_json escapes newline")
assert(to_json("\t") == "\"\\t\"", "to_json escapes tab")

# --- to_json: containers (compact) ------------------------------------------------
assert(to_json([]) == "[]", "to_json empty list")
assert(to_json([1, 2, 3]) == "[1, 2, 3]", "to_json list")
assert(to_json(["a", "b"]) == "[\"a\", \"b\"]", "to_json list of strings")
assert(to_json([1, [2, 3]]) == "[1, [2, 3]]", "to_json nested list")

var t = {"name": "John"}
assert(to_json(t) == "\{\"name\":\"John\"}", "to_json table")

# --- from_json: scalars -----------------------------------------------------------
assert(from_json("null") == null, "from_json null")
assert(from_json("true") == true, "from_json true")
assert(from_json("false") == false, "from_json false")
assert(from_json("42") == 42, "from_json Integer")
assert(from_json("42") is Integer, "from_json integer type")
assert(from_json("-7") == -7, "from_json negative")
assert(from_json("3.14") == 3.14, "from_json Float")
assert(from_json("3.14") is Float, "from_json float type")
assert(from_json("1e3") == 1000.0, "from_json exponent")
assert(from_json("  42  ") == 42, "from_json skips surrounding whitespace")
assert(from_json("\"hello\"") == "hello", "from_json String")

# --- from_json: string escapes ----------------------------------------------------
assert(from_json("\"a\\nb\"") == "a\nb", "from_json unescapes newline")
assert(from_json("\"a\\\"b\"") == "a\"b", "from_json unescapes quote")
assert(from_json("\"a\\tb\"") == "a\tb", "from_json unescapes tab")
assert(from_json("\"\\u0041\"") == "A", "from_json unescapes \\u")
assert(from_json("\"\\u00e9\"") == "é", "from_json unescapes non-ascii \\u")
assert(from_json("\"\\uD83D\\uDE00\"") == "😀", "from_json unescapes surrogate pair")

# --- from_json: containers --------------------------------------------------------
var arr = from_json("[1, 2, 3]")
assert(arr is List, "from_json array is a List")
assert(len(arr) == 3, "from_json array length")
assert(arr[1] == 1 and arr[3] == 3, "from_json array elements")

var empty = from_json("[]")
assert(len(empty) == 0, "from_json empty array")

var obj = from_json("\{\"name\": \"John\", \"pi\": 3.14}")
assert(obj is Table, "from_json object is a Table")
assert(obj["name"] == "John", "from_json object string field")
assert(obj["pi"] == 3.14, "from_json object float field")

var nested = from_json("\{\"items\": [1, 2], \"meta\": \{\"n\": 2}}")
assert(nested["items"][2] == 2, "from_json nested array")
assert(nested["meta"]["n"] == 2, "from_json nested object")

# --- round-trips ------------------------------------------------------------------
assert(from_json(to_json([1, 2, 3])) == [1, 2, 3], "list round-trip")
assert(from_json(to_json("héllo\nwörld")) == "héllo\nwörld", "unicode string round-trip")

var data = {"a": 1, "b": [true, false, null], "c": "text"}
var back = from_json(to_json(data))
assert(back["a"] == 1, "round-trip integer field")
assert(back["b"][1] == true, "round-trip nested bool")
assert(back["b"][3] == null, "round-trip nested null")
assert(back["c"] == "text", "round-trip string field")

# --- pretty printing --------------------------------------------------------------
assert(to_json([1, 2], 2) == "[\n  1,\n  2\n]", "pretty list")
assert(to_json({"a": 1}, 2) == "\{\n  \"a\": 1\n}", "pretty object")
# A pretty document still round-trips.
assert(from_json(to_json(data, 4)) == from_json(to_json(data)), "pretty round-trip")

# --- error handling ---------------------------------------------------------------
var caught = false
try
    from_json("\{bad}")
catch e
    caught = true
end
assert(caught, "from_json raises on malformed input")

caught = false
try
    from_json("[1, 2")
catch e
    caught = true
end
assert(caught, "from_json raises on unterminated array")

print("test_json: all assertions passed")
