# ============================================================
# Phonometrica validation suite — Bayesian regression
#
# Mirrors validate_frequentist_statistics.phon but switches to
# Bayesian estimation (INLA-style grid integration) by passing
# an explicit Prior object as the last argument to fit().
#
# Each family is tested with four model structures:
#   M1: fixed effects only
#   M2: one random intercept (speaker)
#   M3: two crossed random intercepts (speaker + word)
#   M4: random slope (slope_var | speaker)
#
# ── Priors ──────────────────────────────────────────────────
# The same numerical priors are used across all families so that
# the R-side comparison suite (brms + INLA, where applicable)
# can set matching values:
#
#   fixed effects          Normal(0, 10)     (incl. intercept)
#   random-effect SDs      PC(u=1, alpha=0.05)
#   residual SD (Gaussian) PC(u=1, alpha=0.05)
#   negbin theta           Gamma(shape=1, rate=0.01)
#   beta phi               Gamma(shape=1, rate=0.01)
#   student sigma, nu      (defaults — no explicit setter)
#
# PC(u, alpha) induces Exponential(lambda) on σ with
# lambda = -log(alpha) / u.  For PC(1, 0.05): lambda ≈ 2.9957.
# This is what the R script will pass as the rate of an
# Exponential prior in brms, and as "pc.prec" with param=c(1,0.05)
# in INLA.
#
# ── How to read the output ──────────────────────────────────
# summarize() prints, for Bayesian fits:
#   * posterior mean / SD / 95% CrI / pd per coefficient
#   * posterior summaries for random-effect SDs
#   * log-marginal likelihood, WAIC (+ p_WAIC), LOO-IC (+ p_LOO)
#   * Pareto-k summary for LOO
# compare() prints WAIC/LOO-IC tables + log Bayes factors.
#
# Import the .csv files from test/data/ as datasets before
# running this script. Label them:
#   gaussian_f1, binomial_schwa, poisson_disfluency,
#   negbin_hesitation, beta_voicing,
#   student_f1_robust, student_f1_mild
# ============================================================

let root = "/home/julien/Devel/phonometrica/test/data/"

# ── 1. GAUSSIAN ──────────────────────────────────────────────

print "======================================================================"
print " GAUSSIAN (Bayesian)"
print "======================================================================"

let dg = load(root & "gaussian_f1.csv")

let pg = Prior()
set_fixed(pg, 0, 10)
set_variance(pg, "pc", 1, 0.05)
set_residual(pg, "pc", 1, 0.05)

print ""
print "--- M1: f1 ~ vowel + gender ---"
let g1 = fit("f1 ~ vowel + gender", dg, pg)
summarize(g1)

print ""
print "--- M2: f1 ~ vowel + gender + (1|speaker) ---"
let g2 = fit("f1 ~ vowel + gender + (1|speaker)", dg, pg)
summarize(g2)

print ""
print "--- M3: f1 ~ vowel + gender + (1|speaker) + (1|word) ---"
let g3 = fit("f1 ~ vowel + gender + (1|speaker) + (1|word)", dg, pg)
summarize(g3)

print ""
print "--- M4: f1 ~ vowel + (1 + gender|speaker) ---"
let g4 = fit("f1 ~ vowel + (1 + gender|speaker)", dg, pg)
summarize(g4)

print ""
print "--- Model comparison: M2 vs M3 ---"
compare(g2, g3)

# ── 2. BINOMIAL ──────────────────────────────────────────────

print "======================================================================"
print " BINOMIAL (Bayesian)"
print "======================================================================"

let db = load(root & "binomial_schwa.csv")

let pb = Prior()
set_fixed(pb, 0, 10)
set_variance(pb, "pc", 1, 0.05)

print ""
print "--- M1: realized ~ position + style ---"
let b1 = fit("realized ~ position + style", db, "binomial", pb)
summarize(b1)

print ""
print "--- M2: realized ~ position + style + (1|speaker) ---"
let b2 = fit("realized ~ position + style + (1|speaker)", db, "binomial", pb)
summarize(b2)

print ""
print "--- M3: realized ~ position + style + (1|speaker) + (1|word) ---"
let b3 = fit("realized ~ position + style + (1|speaker) + (1|word)", db, "binomial", pb)
summarize(b3)

print ""
print "--- M4: realized ~ position + (1 + style|speaker) ---"
let b4 = fit("realized ~ position + (1 + style|speaker)", db, "binomial", pb)
summarize(b4)

print ""
print "--- Model comparison: M2 vs M3 ---"
compare(b2, b3)

# ── 3. POISSON ───────────────────────────────────────────────

print "======================================================================"
print " POISSON (Bayesian)"
print "======================================================================"

let dp = load(root & "poisson_disfluency.csv")

let pp = Prior()
set_fixed(pp, 0, 10)
set_variance(pp, "pc", 1, 0.05)

print ""
print "--- M1: count ~ task + age ---"
let p1 = fit("count ~ task + age", dp, "poisson", pp)
summarize(p1)

print ""
print "--- M2: count ~ task + age + (1|speaker) ---"
let p2 = fit("count ~ task + age + (1|speaker)", dp, "poisson", pp)
summarize(p2)

print ""
print "--- M3: count ~ task + age + (1|speaker) + (1|word) ---"
let p3 = fit("count ~ task + age + (1|speaker) + (1|word)", dp, "poisson", pp)
summarize(p3)

print ""
print "--- M4: count ~ task + (1 + age|speaker) ---"
let p4 = fit("count ~ task + (1 + age|speaker)", dp, "poisson", pp)
summarize(p4)

print ""
print "--- Model comparison: M2 vs M3 ---"
compare(p2, p3)

# ── 4. NEGATIVE BINOMIAL ─────────────────────────────────────

print "======================================================================"
print " NEGATIVE BINOMIAL (Bayesian)"
print "======================================================================"

let dn = load(root & "negbin_hesitation.csv")

let pn = Prior()
set_fixed(pn, 0, 10)
set_variance(pn, "pc", 1, 0.05)
set_negbin_theta(pn, 1, 0.01)

print ""
print "--- M1: hesitations ~ complexity + stress ---"
let n1 = fit("hesitations ~ complexity + stress", dn, "negbin", pn)
summarize(n1)
print "theta = " & n1.theta

print ""
print "--- M2: hesitations ~ complexity + stress + (1|speaker) ---"
let n2 = fit("hesitations ~ complexity + stress + (1|speaker)", dn, "negbin", pn)
summarize(n2)
print "theta = " & n2.theta

print ""
print "--- M3: hesitations ~ complexity + stress + (1|speaker) + (1|word) ---"
let n3 = fit("hesitations ~ complexity + stress + (1|speaker) + (1|word)", dn, "negbin", pn)
summarize(n3)
print "theta = " & n3.theta

print ""
print "--- M4: hesitations ~ complexity + (1 + stress|speaker) ---"
let n4 = fit("hesitations ~ complexity + (1 + stress|speaker)", dn, "negbin", pn)
summarize(n4)
print "theta = " & n4.theta

print ""
print "--- Model comparison: M1 vs M2 ---"
compare(n1, n2)

print ""
print "--- Model comparison: M2 vs M3 ---"
compare(n2, n3)

# ── 5. BETA ──────────────────────────────────────────────────

print "======================================================================"
print " BETA (Bayesian)"
print "======================================================================"

let dbeta = load(root & "beta_voicing.csv")

let pbeta = Prior()
set_fixed(pbeta, 0, 10)
set_variance(pbeta, "pc", 1, 0.05)
set_beta_phi(pbeta, 1, 0.01)

print ""
print "--- M1: voicing ~ consonant + position ---"
let t1 = fit("voicing ~ consonant + position", dbeta, "beta", pbeta)
summarize(t1)
print "phi = " & t1.phi

print ""
print "--- M2: voicing ~ consonant + position + (1|speaker) ---"
let t2 = fit("voicing ~ consonant + position + (1|speaker)", dbeta, "beta", pbeta)
summarize(t2)
print "phi = " & t2.phi

print ""
print "--- M3: voicing ~ consonant + position + (1|speaker) + (1|word) ---"
let t3 = fit("voicing ~ consonant + position + (1|speaker) + (1|word)", dbeta, "beta", pbeta)
summarize(t3)
print "phi = " & t3.phi

print ""
print "--- M4: voicing ~ consonant + (1 + position|speaker) ---"
let t4 = fit("voicing ~ consonant + (1 + position|speaker)", dbeta, "beta", pbeta)
summarize(t4)
print "phi = " & t4.phi

print ""
print "--- Model comparison: M1 vs M2 ---"
compare(t1, t2)

print ""
print "--- Model comparison: M2 vs M3 ---"
compare(t2, t3)

# ── 6. STUDENT T (ROBUST) ─────────────────────────────────

print "======================================================================"
print " STUDENT T ROBUST (Bayesian)"
print "======================================================================"

let ds = load(root & "student_f1_robust.csv")

# Student-t has no explicit prior setter for sigma/nu — defaults are used.
# Fixed effects and random-effect SDs share the common prior spec.
let ps = Prior()
set_fixed(ps, 0, 10)
set_variance(ps, "pc", 1, 0.05)

print ""
print "--- M1: f1 ~ vowel + gender ---"
let s1 = fit("f1 ~ vowel + gender", ds, "student", ps)
summarize(s1)
print "sigma = " & s1.sigma
print "nu    = " & s1.nu

print ""
print "--- M2: f1 ~ vowel + gender + (1|speaker) ---"
let s2 = fit("f1 ~ vowel + gender + (1|speaker)", ds, "student", ps)
summarize(s2)
print "sigma = " & s2.sigma
print "nu    = " & s2.nu

print ""
print "--- M3: f1 ~ vowel + gender + (1|speaker) + (1|word) ---"
let s3 = fit("f1 ~ vowel + gender + (1|speaker) + (1|word)", ds, "student", ps)
summarize(s3)
print "sigma = " & s3.sigma
print "nu    = " & s3.nu

print ""
print "--- M4: f1 ~ vowel + (1 + gender|speaker) ---"
let s4 = fit("f1 ~ vowel + (1 + gender|speaker)", ds, "student", ps)
summarize(s4)
print "sigma = " & s4.sigma
print "nu    = " & s4.nu

print ""
print "--- Model comparison: M1 vs M2 ---"
compare(s1, s2)

print ""
print "--- Model comparison: M2 vs M3 ---"
compare(s2, s3)


# ── 6b. STUDENT T MILD ───────────────────────────────────

print ""
print "======================================================================"
print " STUDENT T MILD (nu=10) (Bayesian)"
print "======================================================================"

let dm = load(root & "student_f1_mild.csv")

let pm = Prior()
set_fixed(pm, 0, 10)
set_variance(pm, "pc", 1, 0.05)

print ""
print "--- M1: f1 ~ vowel + gender ---"
t1 = fit("f1 ~ vowel + gender", dm, "student", pm)
summarize(t1)
print "sigma = " & t1.sigma
print "nu    = " & t1.nu

print ""
print "--- M2: f1 ~ vowel + gender + (1|speaker) ---"
t2 = fit("f1 ~ vowel + gender + (1|speaker)", dm, "student", pm)
summarize(t2)
print "sigma = " & t2.sigma
print "nu    = " & t2.nu

print ""
print "--- Model comparison: M1 vs M2 ---"
compare(t1, t2)
