# Created: 23/02/2019                                                                                                  #
#                                                                                                                      #
# purpose: Write user settings.                                                                                        #
#                                                                                                                      #
# PORT NOTE (old -> new engine): `dump_json` -> `to_json`; `File(path, "w")` -> `open_file(path, "w")` (File is not    #
# script-constructible; the opener returns a File whose handle closes with the value). write/write_line/close are      #
# engine builtins. `phon` is an isolate global injected by the app via Runtime::add_global; get_config_path()          #
# comes from the app (Settings::initialize). See MIGRATION_NOTES.md.                                                   #
########################################################################################################################

var settings = to_json(phon.settings)
var f = open_file(get_config_path(), "w")

write_line(f, "# This file was generated automatically.")
write_line(f, "# Do not edit it unless you know what you are doing.")
# This line is for compatibility with Phonometrica < 0.8. It is no longer needed
write(f, "phon.settings = ")
write(f, settings)
close(f)
