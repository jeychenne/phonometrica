#                                                                                                                      #
# Purpose: reporting routines for acoustic analysis.                                                                   #
#                                                                                                                      #
# PORT NOTE (old -> new engine): print is a function whose default separator is a space, so the old juxtaposed         #
# `print a, b, c` output is preserved with string interpolation. `result.nrow` -> nrow(result). `if x then` keeps      #
# working for null-or-value app returns (null is the only falsy non-boolean). The get_* / alert natives come from      #
# the application. See MIGRATION_NOTES.md.                                                                             #
########################################################################################################################

function report_intensity(time as Number)
    var sound = get_current_sound()

    if sound then
        print("Intensity at time {time} s:")
        var channels = get_visible_channels()

        for channel in channels do
            var dB = get_intensity(sound, channel, time)

            if channel == 0 then
                print("Average over all channels: {dB} dB")
            else
                print("Channel {channel}: {dB} dB")
            end
        end
    else
        alert("No sound or annotation view is currently selected!")
    end
end

function report_mean_intensity(t1 as Number, t2 as Number)
    var sound = get_current_sound()

    if sound then
        print("Mean intensity from {t1} to {t2}:")
        var channels = get_visible_channels()

        for channel in channels do
            var f0 = get_mean_intensity(sound, channel, t1, t2)
            var label = ""

            if f0 then
                label = f0 & "dB"
            else
                label = "undefined"
            end

            if channel == 0 then
                print("Average over all channels: " & label)
            else
                print("Channel {channel}: " & label)
            end
        end
    else
        alert("No sound or annotation view is currently selected!")
    end
end


