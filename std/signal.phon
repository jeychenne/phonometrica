#                                                                                                                      #
# Created: 23/02/2019                                                                                                  #
#                                                                                                                      #
# purpose: a simple signal/slot (a.k.a event/callback) mechanism. Signals are unique identifiers generated with        #
# create_signal(). A signal can be connected/disconnected to/from a number of slots. Slots can be pure                 #
# Phonometrica functions or C++ functions exposed to the scripting engine. Phonometrica's slots are allowed to         #
# return a value. Values returned by all the slots connected to an event are collected into a list, which is           #
# returned by emit().                                                                                                  #
#                                                                                                                      #
# PORT NOTE (old -> new engine):                                                                                       #
#   - Slots are first-class function values: anonymous functions or (since the M7 fix) named functions passed by      #
#     name. Slot identity (`slot == s`) compares function identity.                                                    #
#   - `ref bindings[id]` alias bindings are gone; mutating natives take the table slot directly                        #
#     (`append(bindings[id], slot)` mutates the stored list in place).                                                 #
#   - `for i = n downto 1` -> `for i = n to 1 step -1`; `callbacks.length` -> `len(callbacks)`.                        #
#   - The internal state (`bindings`, `slot_id`) is `local` (module-private), which the old file could not express.   #
########################################################################################################################

# Table mapping a signal to a list of callbacks
local var bindings = {}
local var slot_id = 0

# Create a new signal, which is represented as a string
function create_signal()
	var id = slot_id
	slot_id += 1

	return "__SIGNAL_" & id
end

# Connect a signal to a slot
function connect(id as String, slot as Function)
	if not contains(bindings, id) then
		bindings[id] = [ slot ]
	else
		# Check whether the signal is already there
		for s in bindings[id] do
			if slot == s then
				return
			end
		end

		append(bindings[id], slot)
	end
end

# Disconnect a signal from a slot
function disconnect(id as String, slot as Function)
	if contains(bindings, id) then
		for i = len(bindings[id]) to 1 step -1 do
			if bindings[id][i] == slot then
				remove_at(bindings[id], i)
				return
			end
		end
	end
end

# Emit a signal, with an argument which will be passed to each slot the event is connected to.
function emit(id as String, args as Object)
	if contains(bindings, id) then
		var callbacks = bindings[id]
		var result = []

		for callback in callbacks do
			append(result, callback(args))
		end

		return result
	end
end

# Emit a signal without any argument
function emit(id as String)
	return emit(id, null)
end


# Define standard events. (The old file created these by implicit global
# assignment; assignment never declares in the new language.)
var SIGNAL_ANNOTATION_IMPORTED = "__SIGNAL_ANNOTATION_IMPORTED"
var SIGNAL_SOUND_IMPORTED = "__SIGNAL_SOUND_IMPORTED"
var SIGNAL_ANNOTATION_LOADED = "__SIGNAL_ANNOTATION_LOADED"
var SIGNAL_SOUND_LOADED = "__SIGNAL_SOUND_LOADED"
var SIGNAL_SCRIPT_LOADED = "__SIGNAL_SCRIPT_LOADED"
var SIGNAL_DATASET_LOADED = "__SIGNAL_DATASET_LOADED"
var SIGNAL_PROJECT_LOADED = "__SIGNAL_PROJECT_LOADED"
