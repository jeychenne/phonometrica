# A module exposing a public class, a public function, and a public const, plus a
# private helper — used to exercise `import ... as`, `for`, `for *`, qualified
# access, `is`, and type annotations across a module boundary (design §11).
const PI = 3.14159

class Point
    field x as Float
    field y as Float
end

function origin() as Point
    return make_point(0.0, 0.0)
end

function make_point(x as Float, y as Float) as Point
    var p = Point()
    p.x = x
    p.y = y
    return p
end

local function clamp(v as Float) as Float
    if v < 0.0 then return 0.0 end
    return v
end

# --- classes with field defaults that reference this module's own scope --------------
# These exist to test cross-module *construction*: the initializers below name a
# module-private const (LABEL) and a module function (base_scale) that are NOT visible
# at an importer's call site. Constructing these from another module must still resolve
# them here — which is what the per-class defaults thunk guarantees (design §11).
const LABEL = "geo"

function base_scale() as Float
    return 2.0
end

class Widget
    field name as String = LABEL          # module-private const
    field scale as Float = base_scale()   # module function
    field count as Integer = 1
end

# A subclass to exercise base→derived default chaining across the construction boundary.
class LabeledWidget is Widget
    field tag as String = LABEL & "-tag"
end
