# The for … in iteration protocol over builtin collections (design §12). The fast
# path keeps state in hidden loop registers — no iterator object, no dispatch.

# List: value, and index/value.
var total = 0
for x in [10, 20, 30, 40] do
    total += x
end
assert(total == 100, "list value sum")

var trace = ""
for i, v in [5, 6, 7] do
    trace = trace & i & "=" & v & ";"
end
assert(trace == "1=5;2=6;3=7;", "list index/value: " & trace)

# Table: key/value pairs (order unspecified — check aggregates).
var codes = {"vowel": 1, "consonant": 2, "other": 3}
var vsum = 0
var kcount = 0
for k, v in codes do
    vsum += v
    kcount += 1
end
assert(vsum == 6, "table value sum")
assert(kcount == 3, "table pair count")

# Set membership.
var members = 0
for x in {3, 6, 9, 12} do
    members += x
end
assert(members == 30, "set sum")

# break / continue.
var picked = 0
for x in [1, 2, 3, 4, 5, 6, 7] do
    if x mod 2 == 0 then continue end
    if x > 5 then break end
    picked += x
end
assert(picked == 1 + 3 + 5, "odd numbers up to 5: " & picked)

# Nested iteration and accumulation into a list.
var grid = []
for a in [1, 2] do
    for b in [10, 20] do
        grid += [a + b]
    end
end
assert(len(grid) == 4, "nested produced 4 items")
assert(grid[1] == 11 and grid[4] == 22, "nested values")

# Iterating an empty collection runs the body zero times.
var ran = false
for x in [] do
    ran = true
end
assert(not ran, "empty collection: body did not run")

print("iteration tests passed")
