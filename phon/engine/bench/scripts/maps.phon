# Table (dictionary) insert + lookup churn: string keys into a Table, then a read-back
# pass. Exercises FlatHashMap hashing/probing, Value hashing, and GETINDEX/SETINDEX with
# CoW on a uniquely-owned table.
var t = {}
var n = 400000
for i = 1 to n do
    t["k-" & i] = i
end
var acc = 0
for i = 1 to n do
    acc += t["k-" & i]
end
assert(acc == n * (n + 1) / 2, "maps churn checksum")
