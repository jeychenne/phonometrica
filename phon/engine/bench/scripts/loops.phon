# Tight numeric loop: FORLOOP/counted iteration + Float arithmetic (ADD/MUL/DIV) in the
# accumulator. No allocation, so this isolates the arithmetic fast paths and the loop
# opcode overhead.
var total = 0.0
for i = 1 to 20000000 do
    total += i * 0.5 - 0.25
end
assert(total > 0.0, "loops accumulator")
